{
  "name": "silentxx-astro-theme",
  "type": "module",
  "version": "1.0.0",
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "preview": "astro preview",
    "astro": "astro",
    "lint": "eslint .",
    "lint-md": "lint-md ./src/content/**/*.{md,mdx}",
    "lint-md:fix": "lint-md ./src/content/**/*.{md,mdx} --fix",
    "lint-staged": "lint-staged",
    "change": "git cliff -o CHANGELOG.md",
    "prepare": "husky",
    "update-covers": "node scripts/update-cover-config.cjs",
    "sync-dsa": "tsx scripts/sync-dsa-data.ts",
    "gen-trades": "tsx scripts/generate-trades.ts",
    "gen-tools": "python scripts/generate-tools-data.py",
    "scan-sell-put": "python scripts/sell-put-scanner.py",
    "gen-all": "npm run gen-trades && npm run sync-dsa && npm run sync-war-room && npm run gen-tools && npm run scan-sell-put",
    "sync-war-room": "tsx scripts/sync-war-room.ts",
    "dsa": "cd ../daily_stock_analysis && python main.py",
    "update": "npm run dsa && npm run gen-all && npm run build",
    "deploy": "npm run update && git add -A && git commit -m \"auto: DSA daily update\" --no-verify && git push"
  },
  "dependencies": {
    "@astrojs/markdown-remark": "^7.2.2",
    "@astrojs/react": "^6.0.2",
    "@astrojs/rss": "^4.0.19",
    "@floating-ui/react": "^0.27.2",
    "@fontsource/noto-sans": "^5.2.10",
    "@fontsource/noto-serif-jp": "^5.1.2",
    "@fontsource/noto-serif-sc": "^5.1.0",
    "@fontsource/open-sans": "^5.2.7",
    "@fontsource/playfair-display": "^5.2.8",
    "@fontsource/poppins": "^5.1.0",
    "@iconify-json/fa6-regular": "^1.2.3",
    "@iconify-json/fa6-solid": "^1.2.3",
    "@iconify-json/gg": "^1.2.2",
    "@iconify-json/ri": "^1.2.5",
    "@nanostores/react": "^0.8.4",
    "@notionhq/client": "^5.1.0",
    "@radix-ui/react-accordion": "^1.2.2",
    "@radix-ui/react-avatar": "^1.1.2",
    "@radix-ui/react-slot": "^1.1.1",
    "@tailwindcss/vite": "^4.3.3",
    "@yeskunall/astro-umami": "0.0.4",
    "astro": "^7.1.6",
    "astro-icon": "^1.1.5",
    "astro-loading-indicator": "^0.7.0",
    "astro-tooltips": "^0.6.2",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "dayjs": "^1.11.13",
    "es-toolkit": "^1.31.0",
    "font-smiley-sans": "^1.0.0",
    "html-entities": "^2.6.0",
    "markdown-it": "^14.1.0",
    "motion": "^11.15.0",
    "nanostores": "^0.11.3",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "react-error-boundary": "^5.0.0",
    "react-icons": "^5.4.0",
    "react-responsive": "^10.0.0",
    "reading-time": "^1.5.0",
    "rehype-autolink-headings": "^7.1.0",
    "rehype-slug": "^6.0.0",
    "rss-parser": "^3.13.0",
    "sanitize-html": "^2.14.0",
    "tailwind-clip-path": "^1.0.0",
    "tailwind-merge": "^2.5.5",
    "tailwindcss": "^4.3.3",
    "tailwindcss-animate": "^1.0.7",
    "tsx": "^4.20.5"
  },
  "devDependencies": {
    "@iconify/react": "^5.2.0",
    "@tailwindcss/container-queries": "^0.1.1",
    "@tailwindcss/typography": "^0.5.15",
    "@types/js-yaml": "^4.0.9",
    "@types/markdown-it": "^14.1.2",
    "@types/react": "^19.1.9",
    "@types/react-dom": "^19.1.7",
    "@types/sanitize-html": "^2.13.0",
    "@typescript-eslint/eslint-plugin": "^8.39.1",
    "@typescript-eslint/parser": "^8.39.1",
    "eslint": "^9.17.0",
    "eslint-plugin-astro": "^1.3.1",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-react-google-translate": "^0.0.114",
    "husky": "^9.1.7",
    "js-yaml": "^4.1.0",
    "lint-staged": "^15.3.0",
    "prettier": "^3.4.2",
    "prettier-plugin-astro": "^0.14.1",
    "prettier-plugin-lint-md": "^1.0.1",
    "prettier-plugin-tailwindcss": "^0.6.11",
    "ts-node": "^10.9.2",
    "typescript": "^5.9.2",
    "vite-plugin-svgr": "^4.3.0"
  },
  "packageManager": "pnpm@10.18.0",
  "lint-staged": {
    "*.{js,jsx,ts,tsx,astro}": [
      "prettier --write"
    ],
    "*.{md,mdx,json}": [
      "prettier --write"
    ]
  },
  "description": "SilentXx Astro Theme — a modern blog theme for content creators: smart TOC (AI-powered), i18n, beautiful typography. 为内容创作者打造的 Astro 博客主题。",
  "keywords": [
    "astro",
    "astro-theme",
    "blog",
    "tailwind",
    "toc",
    "smart-toc",
    "i18n",
    "silentxx"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/AheheXx1982/silentxx-astro-theme.git"
  },
  "license": "MIT"
}
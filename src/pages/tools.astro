---
import Layout from '@layouts/Layout.astro';
import TwoColumnLayout from '@layouts/TwoColumnLayout.astro';
import Cover from '@components/ui/cover/Cover.astro';
import HomeSider from '@components/layout/HomeSider.astro';
import QuoteMarquee from '@components/fun/QuoteMarquee.astro';
import { getAllPosts } from '@lib/content';
import type { CollectionEntry } from 'astro:content';
import { getSeoConfig } from '@lib/i18n';
import { Icon } from 'astro-icon/components';

const lang = 'zh';
const seoConfig = getSeoConfig('zh');

async function getCategoryPosts(lang: string): Promise<CollectionEntry<'blog'>[]> {
  const posts = await getAllPosts();
  const filtered = posts.filter((post) => {
    const postLang = post.data.lang || 'zh';
    if (postLang !== lang) return false;
    const cats = post.data.categories;
    if (!cats || !Array.isArray(cats)) return false;
    const flatCats = cats.flat(Infinity).map((c: unknown) => String(c));
    return flatCats.includes('期权工具箱');
  });
  filtered.sort((a, b) => new Date(b.data.date).getTime() - new Date(a.data.date).getTime());
  return filtered;
}

const posts = await getCategoryPosts(lang);
---

<Layout
  title={`工具与资源 | ${seoConfig.title}`}
  description="期权交易必备工具——券商选择、行情筛选、数据平台、模拟交易、效率模板，一站式提升你的交易体验。"
>
  <TwoColumnLayout>
    <Cover slot="cover" title="工具与资源" />
    <HomeSider slot="sider" lang={lang} />
    <QuoteMarquee />

    <div class="shadow-box bg-gradient-start mx-0 flex w-full flex-col px-6 py-4 md:px-3 md:py-2">
      <div class="mb-8 rounded-r-lg border-l-4 border-amber-500 bg-amber-50 px-6 py-4 dark:bg-amber-950/30">
        <h2 class="mb-3 text-2xl font-bold text-amber-600 dark:text-amber-400">🛠️ 工具与资源</h2>
        <p class="text-muted-foreground leading-relaxed">
          工欲善其事，必先利其器。这里整理了期权交易中真正好用的工具——从券商对比到筛选器，从模拟交易到复盘模板。只推荐自己用过且觉得好用的。
        </p>
      </div>

      <!-- 快速工具入口 -->
      <div class="mb-8">
        <h3 class="mb-4 flex items-center gap-2 text-xl font-bold">
          <span class="inline-block h-6 w-1 rounded bg-gradient-to-b from-amber-500 to-orange-500"></span>
          期权工具
        </h3>
        <div class="grid gap-4 md:grid-cols-2">
          <a
            href="/greeks-calculator"
            class="group bg-card border-border hover:border-primary/30 block rounded-lg border p-5 transition-all duration-300 hover:scale-[1.02] hover:shadow-lg"
          >
            <div class="flex items-start gap-4">
              <div
                class="flex h-12 w-12 flex-shrink-0 items-center justify-center rounded-lg bg-gradient-to-br from-amber-500 to-orange-500 text-white"
              >
                <Icon name="ri:calculator-line" class="h-6 w-6" />
              </div>
              <div class="flex-1">
                <h4
                  class="text-primary mb-2 text-lg font-semibold transition-colors group-hover:text-amber-600 dark:group-hover:text-amber-400"
                >
                  Greeks 计算器
                </h4>
                <p class="text-muted-foreground text-sm">Delta · Gamma · Theta · Vega 一键计算，可视化期权风险参数。</p>
              </div>
            </div>
          </a>
        </div>
      </div>

      <!-- 猎手出品：自研项目 -->
      <div class="mb-8">
        <h3 class="mb-2 flex items-center gap-2 text-xl font-bold">
          <span class="inline-block h-6 w-1 rounded bg-gradient-to-b from-purple-500 to-indigo-500"></span>
          猎手出品
        </h3>
        <p class="text-muted-foreground mb-4 text-sm">
          自己开发、自己天天在用的工具。开源的可以直接取用，私人的仅作展示，数据不共享。
        </p>
        <div class="grid gap-4 md:grid-cols-2">
          <a
            href="/tools/silentxx-smart-toc"
            class="group bg-card border-border hover:border-primary/30 block rounded-lg border p-5 transition-all duration-300 hover:scale-[1.02] hover:shadow-lg"
          >
            <div class="flex items-start gap-4">
              <div
                class="flex h-12 w-12 flex-shrink-0 items-center justify-center rounded-lg bg-gradient-to-br from-purple-500 to-indigo-500 text-white"
              >
                <Icon name="ri:robot-2-line" class="h-6 w-6" />
              </div>
              <div class="flex-1">
                <div class="mb-1 flex items-center gap-2">
                  <h4
                    class="text-primary text-lg font-semibold transition-colors group-hover:text-purple-600 dark:group-hover:text-purple-400"
                  >
                    SilentXx SmartToc
                  </h4>
                  <span class="rounded bg-emerald-500/10 px-1.5 py-0.5 text-xs text-emerald-600 dark:text-emerald-400"
                    >开源</span
                  >
                </div>
                <p class="text-muted-foreground text-sm">AI 智能文章目录组件，五级降级链，npm 可装。</p>
              </div>
            </div>
          </a>
          <a
            href="/tools/silentxx-app"
            class="group bg-card border-border hover:border-primary/30 block rounded-lg border p-5 transition-all duration-300 hover:scale-[1.02] hover:shadow-lg"
          >
            <div class="flex items-start gap-4">
              <div
                class="flex h-12 w-12 flex-shrink-0 items-center justify-center rounded-lg bg-gradient-to-br from-slate-600 to-slate-800 text-white"
              >
                <Icon name="ri:terminal-box-line" class="h-6 w-6" />
              </div>
              <div class="flex-1">
                <div class="mb-1 flex items-center gap-2">
                  <h4
                    class="text-primary text-lg font-semibold transition-colors group-hover:text-slate-500 dark:group-hover:text-slate-300"
                  >
                    超级终端
                  </h4>
                  <span class="rounded bg-amber-500/10 px-1.5 py-0.5 text-xs text-amber-600 dark:text-amber-400">私人</span>
                </div>
                <p class="text-muted-foreground text-sm">本地优先的私人 AI 控制台：语音交互、实时面板、数据不出本机。</p>
              </div>
            </div>
          </a>
        </div>
      </div>

      <div class="mb-6">
        <h3 class="mb-4 flex items-center gap-2 text-xl font-bold">
          <span class="inline-block h-6 w-1 rounded bg-gradient-to-b from-amber-500 to-orange-500"></span>
          相关文章
        </h3>
        {
          posts.length > 0 ? (
            <div class="grid gap-4 md:grid-cols-1">
              {posts.map((post) => (
                <a
                  href={`/article/${post.data.link ?? (typeof post.slug === 'string' ? post.slug.split('/').pop() || post.slug : String(post.slug))}`}
                  class="group bg-card border-border hover:border-primary/30 block rounded-lg border p-5 transition-all duration-300 hover:scale-[1.02] hover:shadow-lg"
                >
                  <div class="flex items-start gap-4">
                    <div class="flex h-12 w-12 flex-shrink-0 items-center justify-center rounded-lg bg-gradient-to-br from-amber-500 to-orange-500 text-lg font-bold text-white">
                      <Icon name="ri:article-line" class="h-6 w-6" />
                    </div>
                    <div class="min-w-0 flex-1">
                      <h4 class="text-primary mb-2 text-lg font-semibold transition-colors group-hover:text-amber-600 dark:group-hover:text-amber-400">
                        {post.data.title}
                      </h4>
                      <p class="text-muted-foreground mb-2 line-clamp-2 text-sm">{post.data.description || ''}</p>
                      <div class="text-muted-foreground flex items-center gap-4 text-xs">
                        <span>📅 {new Date(post.data.date).toLocaleDateString('zh-CN')}</span>
                        {post.data.tags && post.data.tags.length > 0 && (
                          <div class="flex gap-1">
                            {post.data.tags.slice(0, 3).map((tag: string) => (
                              <span class="bg-primary/10 rounded-full px-2 py-0.5">#{tag}</span>
                            ))}
                          </div>
                        )}
                      </div>
                    </div>
                  </div>
                </a>
              ))}
            </div>
          ) : (
            <div class="text-muted-foreground py-12 text-center">
              <p class="text-sm">工具评测与使用指南正在撰写中</p>
            </div>
          )
        }
      </div>

      <div class="mt-8 grid grid-cols-1 gap-4 md:grid-cols-3">
        <div class="rounded-lg bg-gradient-to-br from-amber-50 to-amber-100 p-4 dark:from-amber-950/30 dark:to-amber-900/20">
          <div class="mb-2 text-3xl">🏦</div>
          <h4 class="mb-1 font-semibold text-amber-900 dark:text-amber-300">券商评测</h4>
          <p class="text-muted-foreground text-sm">IBKR · 老虎 · 富途 实测对比</p>
        </div>
        <div
          class="rounded-lg bg-gradient-to-br from-orange-50 to-orange-100 p-4 dark:from-orange-950/30 dark:to-orange-900/20"
        >
          <div class="mb-2 text-3xl">📋</div>
          <h4 class="mb-1 font-semibold text-orange-900 dark:text-orange-300">效率模板</h4>
          <p class="text-muted-foreground text-sm">复盘模板 · 扫描清单 · 自动化</p>
        </div>
        <div
          class="rounded-lg bg-gradient-to-br from-yellow-50 to-yellow-100 p-4 dark:from-yellow-950/30 dark:to-yellow-900/20"
        >
          <div class="mb-2 text-3xl">🤖</div>
          <h4 class="mb-1 font-semibold text-yellow-900 dark:text-yellow-300">AI 工具</h4>
          <p class="text-muted-foreground text-sm">Hermes · AI 工作流 · 自动化</p>
        </div>
      </div>
    </div>
  </TwoColumnLayout>
</Layout>

---
import ButtonLink from '@components/control/ButtonLink.astro';
import HomeSider from '@components/layout/HomeSider.astro';
import PostList from '@components/post/PostList.astro';
import Cover from '@components/ui/cover/Cover.astro';
import { HomeSiderType } from '@constants/enum';
import Layout from '@layouts/Layout.astro';
import TwoColumnLayout from '@layouts/TwoColumnLayout.astro';
import { getRandomLatestPosts } from '@lib/content';
import { getSeoConfig } from '@lib/i18n';
import { Icon } from 'astro-icon/components';
import QuoteMarquee from '@components/fun/QuoteMarquee.astro';

const posts = await getRandomLatestPosts(5, 'zh');
const seoConfig = getSeoConfig('zh');
---

<Layout title={seoConfig.title}>
  <TwoColumnLayout>
    <Cover slot="cover" lang="zh" />
    <HomeSider slot="sider" lang="zh" />
    <QuoteMarquee lang="zh" />
    <div class="shadow-box bg-gradient-start tablet:shadow-none flex flex-col gap-4 overflow-hidden p-4 pt-6 md:px-1 md:py-2">
      <PostList posts={posts} showPaginator={false} />
    </div>
    <div class="flex w-full flex-col items-center">
      <ButtonLink variant="gradient-shoka" url="/articles" size="lg" label="所有文章" className="mt-10 items-center">
        所有文章
        <Icon name="gg:format-justify" />
      </ButtonLink>
    </div>
  </TwoColumnLayout>
</Layout>
---
import HomeSider from '@components/layout/HomeSider.astro';
import PostList from '@components/post/PostList.astro';
import Cover from '@components/ui/cover/Cover.astro';
import Layout from '@layouts/Layout.astro';
import TwoColumnLayout from '@layouts/TwoColumnLayout.astro';
import { getSortedPosts } from '@lib/content';
import { getSeoConfig } from '@lib/i18n';
import type { PaginateFunction } from 'astro';
import QuoteMarquee from '@components/fun/QuoteMarquee.astro';

export async function getStaticPaths({ paginate }: { paginate: PaginateFunction }) {
  const postCollections = await getSortedPosts('en', true);
  const pages = await paginate(postCollections, {
    pageSize: 10,
  });

  // 为第一页添加额外的路径 /en/articles/1
  if (pages.length > 0) {
    const firstPage = pages[0];
    pages.push({
      params: { page: '1' },
      props: firstPage.props,
    });
  }

  return pages;
}

const { page } = Astro.props;
const seoConfig = getSeoConfig('en');
---

<Layout title={seoConfig.title} lang="en">
  <TwoColumnLayout>
    <Cover slot="cover" />
    <HomeSider slot="sider" lang="en" />
    <QuoteMarquee />
    <div class="shadow-box bg-gradient-start tablet:shadow-none flex flex-col gap-4 overflow-hidden p-4 pt-6 md:px-1 md:py-2">
      <PostList posts={page.data} page={page} lang="en" />
    </div>
  </TwoColumnLayout>
</Layout>

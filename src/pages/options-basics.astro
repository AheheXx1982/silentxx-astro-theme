---
import Layout from '@layouts/Layout.astro';
import TwoColumnLayout from '@layouts/TwoColumnLayout.astro';
import Cover from '@components/ui/cover/Cover.astro';
import HomeSider from '@components/layout/HomeSider.astro';
import QuoteMarquee from '@components/fun/QuoteMarquee.astro';
import { getAllPosts } from '@lib/content';
import type { CollectionEntry } from 'astro:content';
import { getSeoConfig } from '@lib/i18n';

const lang = 'zh';
const seoConfig = getSeoConfig('zh');

async function getCategoryPosts(lang: string): Promise<CollectionEntry<'blog'>[]> {
  const posts = await getAllPosts();
  const filtered = posts.filter((post) => {
    const postLang = post.data.lang || 'zh';
    if (postLang !== lang) return false;
    const cats = post.data.categories;
    if (!cats || !Array.isArray(cats)) return false;
    const flatCats = cats.flat(Infinity).map((c: unknown) => String(c));
    return flatCats.includes('期权入门与基础');
  });
  filtered.sort((a, b) => new Date(b.data.date).getTime() - new Date(a.data.date).getTime());
  return filtered;
}

const posts = await getCategoryPosts(lang);
---

<Layout title={`新手入门 | ${seoConfig.title}`} description="从零开始学期权——基础概念、核心参数、新手避坑指南。用最通俗的语言讲清楚期权是什么、怎么用。">
  <TwoColumnLayout>
    <Cover slot="cover" title="新手入门" />
    <HomeSider slot="sider" lang={lang} />
    <QuoteMarquee />

    <div class="shadow-box bg-gradient-start mx-0 flex w-full flex-col px-6 py-4 md:px-3 md:py-2">
      <div class="mb-8 border-l-4 border-blue-500 bg-blue-50 dark:bg-blue-950/30 px-6 py-4 rounded-r-lg">
        <h2 class="text-2xl font-bold text-blue-600 dark:text-blue-400 mb-3">📘 新手入门</h2>
        <p class="text-muted-foreground leading-relaxed">
          如果你对期权还是一张白纸，从这里开始。不需要金融背景——用生活化的类比讲清楚 Call、Put、Greeks 到底是什么，帮你打好地基、少走弯路。
        </p>
      </div>

      <div class="mb-6">
        <h3 class="text-xl font-bold mb-4 flex items-center gap-2">
          <span class="inline-block w-1 h-6 bg-gradient-to-b from-blue-500 to-purple-500 rounded"></span>
          全部文章
        </h3>
        {
          posts.length > 0 ? (
            <div class="grid gap-4 md:grid-cols-1">
              {posts.map((post) => (
                <a
                  href={`/article/${post.data.link ?? (typeof post.slug === 'string' ? post.slug.split('/').pop() || post.slug : String(post.slug))}`}
                  class="group block bg-card border border-border rounded-lg p-5 transition-all duration-300 hover:shadow-lg hover:scale-[1.02] hover:border-primary/30"
                >
                  <div class="flex items-start gap-4">
                    <div class="flex-shrink-0 w-12 h-12 bg-gradient-to-br from-blue-500 to-purple-500 rounded-lg flex items-center justify-center text-white font-bold text-lg">
                      <svg xmlns="http://www.w3.org/2000/svg" class="h-6 w-6" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M4 19.5A2.5 2.5 0 0 1 6.5 17H20"/><path d="M6.5 2H20v20H6.5A2.5 2.5 0 0 1 4 19.5v-15A2.5 2.5 0 0 1 6.5 2z"/></svg>
                    </div>
                    <div class="flex-1 min-w-0">
                      <h4 class="text-lg font-semibold text-primary group-hover:text-blue-600 dark:group-hover:text-blue-400 mb-2 transition-colors">
                        {post.data.title}
                      </h4>
                      <p class="text-sm text-muted-foreground line-clamp-2 mb-2">
                        {post.data.description || ''}
                      </p>
                      <div class="flex items-center gap-4 text-xs text-muted-foreground">
                        <span>📅 {new Date(post.data.date).toLocaleDateString('zh-CN')}</span>
                        {post.data.tags && post.data.tags.length > 0 && (
                          <div class="flex gap-1">
                            {post.data.tags.slice(0, 3).map((tag: string) => (
                              <span class="px-2 py-0.5 bg-primary/10 rounded-full">#{tag}</span>
                            ))}
                          </div>
                        )}
                      </div>
                    </div>
                  </div>
                </a>
              ))}
            </div>
          ) : (
            <div class="text-center py-16 text-muted-foreground">
              <div class="text-4xl mb-3">📚</div>
              <p class="text-lg font-semibold">内容正在建设中</p>
              <p class="text-sm mt-1">期权入门文章即将陆续上线</p>
            </div>
          )
        }
      </div>

      <div class="mt-8 grid grid-cols-1 md:grid-cols-3 gap-4">
        <div class="bg-gradient-to-br from-blue-50 to-blue-100 dark:from-blue-950/30 dark:to-blue-900/20 rounded-lg p-4">
          <div class="text-3xl mb-2">🧩</div>
          <h4 class="font-semibold mb-1 text-blue-900 dark:text-blue-300">零基础友好</h4>
          <p class="text-sm text-muted-foreground">生活化类比，不堆砌术语</p>
        </div>
        <div class="bg-gradient-to-br from-purple-50 to-purple-100 dark:from-purple-950/30 dark:to-purple-900/20 rounded-lg p-4">
          <div class="text-3xl mb-2">🗺️</div>
          <h4 class="font-semibold mb-1 text-purple-900 dark:text-purple-300">体系化结构</h4>
          <p class="text-sm text-muted-foreground">按学习路径排列，循序渐进</p>
        </div>
        <div class="bg-gradient-to-br from-green-50 to-green-100 dark:from-green-950/30 dark:to-green-900/20 rounded-lg p-4">
          <div class="text-3xl mb-2">⚠️</div>
          <h4 class="font-semibold mb-1 text-green-900 dark:text-green-300">避坑优先</h4>
          <p class="text-sm text-muted-foreground">先学什么不该做，再学怎么做</p>
        </div>
      </div>
    </div>
  </TwoColumnLayout>
</Layout>

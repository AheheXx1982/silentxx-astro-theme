---
import Layout from '@layouts/Layout.astro';
import TwoColumnLayout from '@layouts/TwoColumnLayout.astro';
import Cover from '@components/ui/cover/Cover.astro';
import HomeSider from '@components/layout/HomeSider.astro';
import QuoteMarquee from '@components/fun/QuoteMarquee.astro';
import { SilentXxSmartToc } from '@components/layout/SilentXxSmartToc';
import { getSeoConfig } from '@lib/i18n';
import { Icon } from 'astro-icon/components';

const seoConfig = getSeoConfig('zh');
---

<Layout
  title={`SilentXx SmartToc | ${seoConfig.title}`}
  description="SilentXx SmartToc — 开源 AI 智能文章目录组件：标题树、AI 语义章节、伪标题识别、段落导航五级降级。为 Astro + React 站点设计。"
>
  <TwoColumnLayout>
    <Cover slot="cover" title="SilentXx SmartToc" />
    <HomeSider slot="sider" lang="zh" />
    <QuoteMarquee />

    <div class="shadow-box bg-gradient-start mx-0 flex w-full flex-col gap-6 px-6 py-4 md:px-3 md:py-2">
      <!-- 头部 -->
      <div class="mb-2 rounded-r-lg border-l-4 border-purple-500 bg-purple-50 px-6 py-4 dark:bg-purple-950/30">
        <h2 class="mb-3 text-2xl font-bold text-purple-600 dark:text-purple-400">🤖 SilentXx SmartToc</h2>
        <p class="text-muted-foreground leading-relaxed">
          开源 AI 智能文章目录组件。无论文章有没有标题结构，它都能自动生成最合适的左侧目录——真正的标题树、AI
          语义章节、伪标题识别、段落导航，五级降级，全程不改文章内容。
        </p>
      </div>

      <!-- 安装与链接 -->
      <div class="grid gap-4 md:grid-cols-3">
        <div class="bg-card border-border rounded-lg border p-4">
          <div class="mb-2 text-2xl">📦</div>
          <h4 class="mb-2 font-semibold">npm 安装</h4>
          <code class="bg-muted/60 block rounded px-3 py-2 text-sm">npm i silentxx-smart-toc</code>
        </div>
        <a
          href="https://github.com/AheheXx1982/silentxx-smart-toc"
          target="_blank"
          class="bg-card border-border hover:border-primary/40 rounded-lg border p-4 transition-all duration-300 hover:shadow-lg"
        >
          <div class="mb-2 text-2xl">🐙</div>
          <h4 class="mb-2 font-semibold">GitHub 开源</h4>
          <p class="text-muted-foreground text-sm">AheheXx1982/silentxx-smart-toc · MIT</p>
        </a>
        <div class="bg-card border-border rounded-lg border p-4">
          <div class="mb-2 text-2xl">🧠</div>
          <h4 class="mb-2 font-semibold">5 级降级链</h4>
          <p class="text-muted-foreground text-sm">标题树 → AI 章节 → 伪标题 → 段落导航 → 暂无</p>
        </div>
      </div>

      <!-- 实时 Demo -->
      <div class="mt-2">
        <h3 class="mb-4 flex items-center gap-2 text-xl font-bold">
          <span class="inline-block h-6 w-1 rounded bg-gradient-to-b from-purple-500 to-indigo-500"></span>
          实时 Demo — AI 智能目录
        </h3>
        <p class="text-muted-foreground mb-4 text-sm">
          下面这段正文故意没有写任何标题，左侧目录由 AI 按语义自动聚类生成——试试点击目录项跳转、滚动看高亮。
        </p>

        <div class="grid gap-4 md:grid-cols-[16rem_1fr]">
          <!-- 目录（组件渲染） -->
          <div class="bg-card border-border rounded-lg border p-4">
            <div class="text-muted-foreground mb-2 text-sm font-semibold">📑 文章目录</div>
            <SilentXxSmartToc client:load defaultExpanded tocDataUrl="/toc-data/silentxx-smart-toc-demo.json" />
          </div>

          <!-- 示例正文（无标题结构） -->
          <article class="prose prose-sm dark:prose-invert bg-card border-border max-w-none space-y-4 rounded-lg border p-6">
            <p>
              做博客和内容站的朋友，大概都有过这样的烦恼：从公众号、论坛或者旧 CMS 迁移过来的文章，正文里根本没有 Markdown
              标题结构。老目录组件一看没有 h2 h3，直接甩给你一句"暂无目录"。一篇三千字的长文，读者翻到底都不知道自己读到哪里了。
            </p>
            <p>
              SmartToc 的核心是一个五级降级链：文章有标准标题，就用标题树；没有标题但有构建时生成的 AI
              数据，就用语义章节；作者用普通短句当小标题，就识别成伪标题；实在什么都没有，就退化成段落导航。每一级都在尽力给读者最好的导航体验。
            </p>
            <p>
              对于没有标题结构的存量文章，AI
              会把相邻段落按语义聚类——讲同一件事的段落归成一章，然后给每一章生成一个精炼的小标题。目录数据存在独立的 JSON
              文件里，组件只负责渲染到侧边栏，文章本身一字不改。想生成这份数据，任意支持 JSON 输出的 LLM
              都能胜任，构建时跑一遍就缓存了。
            </p>
            <p>
              组件已开源在 GitHub，MIT 协议，包名 silentxx-smart-toc。安装只需要一条 npm 命令，正文用 article
              标签一包，剩下的全部自动。文档有中英文双语，配了架构图和常见问题，照着快速开始五分钟就能用上。
            </p>
            <p>
              这是 SilentXx 开源的第一款作品，但不会是最后一个。期权交易系统、AI
              自动化工作流、内容创作管道——后续会陆续把沉淀下来的工具开源出来。如果你觉得这个组件有用，欢迎点个 Star，或者提
              issue 告诉我们你的场景。
            </p>
          </article>
        </div>
      </div>

      <!-- 功能特性 -->
      <div class="mt-2">
        <h3 class="mb-4 flex items-center gap-2 text-xl font-bold">
          <span class="inline-block h-6 w-1 rounded bg-gradient-to-b from-purple-500 to-indigo-500"></span>
          功能特性
        </h3>
        <div class="grid gap-3 md:grid-cols-2">
          <div class="bg-card border-border flex items-start gap-3 rounded-lg border p-4">
            <span class="text-xl">🤖</span>
            <div>
              <h4 class="mb-1 font-semibold">AI 语义章节</h4><p class="text-muted-foreground text-sm">
                无标题文章由 AI 按语义聚类生成精炼小标题，仅输出到目录树，不改文章
              </p>
            </div>
          </div>
          <div class="bg-card border-border flex items-start gap-3 rounded-lg border p-4">
            <span class="text-xl">🌲</span>
            <div>
              <h4 class="mb-1 font-semibold">标题树</h4><p class="text-muted-foreground text-sm">
                层级缩进 + 自动编号（1. / 1.1 / 1.2…），默认全展开，滚动手风琴定位
              </p>
            </div>
          </div>
          <div class="bg-card border-border flex items-start gap-3 rounded-lg border p-4">
            <span class="text-xl">✨</span>
            <div>
              <h4 class="mb-1 font-semibold">伪标题识别</h4><p class="text-muted-foreground text-sm">
                自动识别作者用普通短句写的小标题，生成精炼目录
              </p>
            </div>
          </div>
          <div class="bg-card border-border flex items-start gap-3 rounded-lg border p-4">
            <span class="text-xl">🧭</span>
            <div>
              <h4 class="mb-1 font-semibold">滚动高亮 + 平滑跳转</h4><p class="text-muted-foreground text-sm">
                随阅读位置自动高亮，点击目录项平滑滚动
              </p>
            </div>
          </div>
          <div class="bg-card border-border flex items-start gap-3 rounded-lg border p-4">
            <span class="text-xl">🆔</span>
            <div>
              <h4 class="mb-1 font-semibold">稳定中文锚点</h4><p class="text-muted-foreground text-sm">
                生成 #为什么剩下 式真实锚点 id，替代 heading-0 弱 id
              </p>
            </div>
          </div>
          <div class="bg-card border-border flex items-start gap-3 rounded-lg border p-4">
            <span class="text-xl">📦</span>
            <div>
              <h4 class="mb-1 font-semibold">零内容改动</h4><p class="text-muted-foreground text-sm">
                纯客户端组件，不碰 Markdown 源文件与渲染链
              </p>
            </div>
          </div>
        </div>
      </div>

      <!-- 版本记录 -->
      <div class="mt-2">
        <h3 class="mb-4 flex items-center gap-2 text-xl font-bold">
          <span class="inline-block h-6 w-1 rounded bg-gradient-to-b from-purple-500 to-indigo-500"></span>
          版本记录
        </h3>
        <div class="space-y-2">
          <div class="bg-card border-border flex gap-3 rounded-lg border p-3 text-sm">
            <span class="h-fit shrink-0 rounded-full bg-purple-500/10 px-2 py-0.5 text-purple-600 dark:text-purple-400"
              >v1.2</span
            >
            <span class="text-muted-foreground">AI 语义章节（构建时 JSON 数据）+ tocDataUrl 参数</span>
          </div>
          <div class="bg-card border-border flex gap-3 rounded-lg border p-3 text-sm">
            <span class="h-fit shrink-0 rounded-full bg-purple-500/10 px-2 py-0.5 text-purple-600 dark:text-purple-400"
              >v1.1</span
            >
            <span class="text-muted-foreground">伪标题识别（独立短句 5-30 字）</span>
          </div>
          <div class="bg-card border-border flex gap-3 rounded-lg border p-3 text-sm">
            <span class="h-fit shrink-0 rounded-full bg-purple-500/10 px-2 py-0.5 text-purple-600 dark:text-purple-400"
              >v1.0</span
            >
            <span class="text-muted-foreground">标题树 + 段落导航，滚动高亮，中文锚点</span>
          </div>
        </div>
      </div>

      <div class="mt-2 text-center">
        <a
          href="/tools"
          class="text-muted-foreground hover:text-primary inline-flex items-center gap-1 text-sm transition-colors"
        >
          <Icon name="ri:arrow-left-line" class="h-4 w-4" /> 返回工具与资源
        </a>
      </div>
    </div>
  </TwoColumnLayout>
</Layout>

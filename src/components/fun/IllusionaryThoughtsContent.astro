<div class="illusionary-thoughts-content">
  <div class="text-center py-8">
    <div class="bg-white dark:bg-gray-800 rounded-2xl border border-gray-200 dark:border-gray-700 p-8 mb-6 shadow-lg w-full mx-auto">
      <h1 class="flex items-center justify-center text-3xl font-bold mb-4">
        <img src="/whirlwind.svg" alt="幻念集图标" class="h-8 w-8 mr-2 reverse-slow-spin" />
        {currentContent.title}
      </h1>
      <p class="text-lg text-gray-600 dark:text-gray-400">
        {currentContent.description}
      </p>
    </div>
  </div>
  <WaterfallFlow items={currentItems} />
</div>
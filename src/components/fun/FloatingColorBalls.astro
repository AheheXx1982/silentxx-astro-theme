  .combo-classify { animation: comboClassify 6s ease-in-out infinite; }
  .combo-clover { animation: comboClover 7s ease-in-out infinite; }
  .combo-polar-star { animation: comboPolarStar 8s linear infinite; }
  .combo-big-dipper { animation: comboBigDipper 10s ease-in-out infinite; }
  .combo-butterfly { animation: comboButterfly 6s ease-in-out infinite; }
  .combo-flower-bloom { animation: comboFlowerBloom 8s ease-in-out infinite; }

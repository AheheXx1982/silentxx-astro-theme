    // 根据颜色球播放对应色系的音乐
    async playColorMusic(colorValue: string, ball: HTMLElement) {
      console.log(`🎨 点击了颜色球: ${colorValue}`);
      
      // 检查全局音乐播放器是否正在播放，如果是则暂停它
      const globalMusicPlayer = (window as any).musicPlayer;
      if (globalMusicPlayer && globalMusicPlayer.isPlaying && globalMusicPlayer.audioElement) {
        console.log('🎧 全局音乐播放器正在播放，暂停其播放');
        globalMusicPlayer.audioElement.pause();
        globalMusicPlayer.isPlaying = false;
        globalMusicPlayer.updateUI();
      }
      
      // 停止之前的音乐和视觉效果
      this.stopMusic();
      
      // 获取该色系的音乐候选列表
      const musicCandidates = this.colorMusicGroups[colorValue];
      if (!musicCandidates || musicCandidates.length === 0) {
        console.warn(`⚠️ 未找到颜色 ${colorValue} 对应的音乐`);
        // 如果没有音乐文件，只显示视觉效果
        this.addVisualFeedback(ball);
        setTimeout(() => {
          this.removeVisualFeedback();
        }, 2000);
        return;
      }
      
      // 随机选择该色系的一首音乐
      const randomIndex = Math.floor(Math.random() * musicCandidates.length);
      const selectedMusic = musicCandidates[randomIndex];
      const musicPath = `/colorball-music/${selectedMusic}`;
      
      console.log(`🎵 为色系 ${colorValue} 播放音乐: ${selectedMusic}`);
      
      try {
            // 创建新的音频实例
            this.currentAudio = new Audio(musicPath);
            this.currentAudio.volume = this.volume; // 使用统一音量控制
            this.currentAudio.loop = false; // 只播放一次，不循环
            
            // 音量标准化处理
            // 为不同音乐文件设置预定义的音量系数，以平衡音量差异
            const volumeCoefficients: { [key: string]: number } = {
              'red.mp3': 0.8,
              'pink1.mp3': 0.7,
              'blue1.mp3': 0.9,
              'green2.mp3': 0.8,
              'purple.mp3': 0.85,
              'yellow2.mp3': 0.75,
              'orange1.mp3': 0.8,
              'lavender1.mp3': 0.7,
              'cyan.mp3': 0.8,
              'generic-background.mp3': 0.8,
              'Nikolaj Egelund-Arrival Manor House.mp3': 0.75,
              'Painless Destiny-Lost control.mp3': 0.8
            };
            
            // 根据文件名调整音量系数
            const fileName = selectedMusic;
            const coefficient = volumeCoefficients[fileName] || 1.0;
            this.currentAudio.volume = this.volume * coefficient;
            
            // 添加淡出效果控制
            let fadeOutInterval: NodeJS.Timeout | null = null;
            
            // 设置当前播放的球
            this.currentPlayingBall = ball;
            
            // 添加视觉反馈
            this.addVisualFeedback(ball);
            
            // 添加详细的事件监听
            this.currentAudio.addEventListener('loadstart', () => {
              console.log('📁 开始加载音频文件');
            });
            
            this.currentAudio.addEventListener('canplay', () => {
              console.log('✅ 音频文件已准备好，可以播放');
            });
            
            this.currentAudio.addEventListener('play', () => {
              console.log('▶️ 音频开始播放');
              this.isPlaying = true;
              
              // 启动淡出效果检测
              if (fadeOutInterval) clearInterval(fadeOutInterval);
              const audio = this.currentAudio;
              if (audio) {
                fadeOutInterval = setInterval(() => {
                  if (audio.duration && audio.currentTime) {
                    // 计算剩余时间
                    const remainingTime = audio.duration - audio.currentTime;
                    
                    // 如果剩余时间在2秒内，开始淡出
                    if (remainingTime <= 2 && remainingTime > 0) {
                      // 计算淡出比例 (0到1之间)
                      const fadeRatio = Math.max(0, remainingTime / 2);
                      // 应用淡出效果
                      audio.volume = 0.7 * fadeRatio;
                    }
                    
                    // 如果音频结束，清理定时器
                    if (remainingTime <= 0) {
                      if (fadeOutInterval) clearInterval(fadeOutInterval);
                    }
                  }
                }, 100); // 每100毫秒检查一次
              }
            });
            
            this.currentAudio.addEventListener('pause', () => {
              console.log('⏸️ 音频暂停');
              this.isPlaying = false;
              // 暂停时清理淡出定时器
              if (fadeOutInterval) clearInterval(fadeOutInterval);
              // 暂停时不移除视觉反馈，用户可能要恢复播放
            });
            
            this.currentAudio.addEventListener('ended', () => {
              console.log('🎵 音频播放结束');
              this.isPlaying = false;
              // 音乐播放结束后移除视觉反馈
              this.removeVisualFeedback();
              this.currentPlayingBall = null;
              this.currentAudio = null; // 清除音频实例
              // 清理淡出定时器
              if (fadeOutInterval) clearInterval(fadeOutInterval);
            });
            
            this.currentAudio.addEventListener('error', (e) => {
              console.error(`❌ 播放音乐失败: ${selectedMusic}`, e);
              console.error('错误类型:', e.type);
              console.error('错误代码:', this.currentAudio?.error?.code);
              console.error('错误信息:', this.currentAudio?.error?.message);
              
              this.isPlaying = false;
              this.removeVisualFeedback();
              // 清理淡出定时器
              if (fadeOutInterval) clearInterval(fadeOutInterval);
            });
            
            // 开始播放
            console.log('🎵 开始播放音频...');
            await this.currentAudio.play();
            
            console.log(`🎶 成功播放 ${colorValue} 色系音乐: ${selectedMusic}`);
            
          } catch (error) {
            console.error(`❌ 播放音乐失败: ${selectedMusic}`, error);
            this.isPlaying = false;
            this.removeVisualFeedback();
            // 如果播放失败，只显示视觉效果
            this.addVisualFeedback(ball);
            setTimeout(() => {
              this.removeVisualFeedback();
            }, 2000);
          }
    }
    
    // 添加视觉反馈效果
    addVisualFeedback(ball: HTMLElement) {
      // 添加播放状态类
      ball.classList.add('playing');
      
      // 清除其他球的播放状态
      const allBalls = document.querySelectorAll('.color-ball');
      allBalls.forEach(otherBall => {
        if (otherBall !== ball) {
          otherBall.classList.remove('playing');
        }
      });
      
      console.log('✨ 添加视觉反馈效果');
    }
    
    // 移除视觉反馈效果
    removeVisualFeedback() {
      if (this.currentPlayingBall) {
        this.currentPlayingBall.classList.remove('playing');
      }
      
      // 确保清除所有球的播放状态
      const allBalls = document.querySelectorAll('.color-ball');
      allBalls.forEach(ball => {
        ball.classList.remove('playing');
      });
      
      console.log('🚫 移除视觉反馈效果');
    }
    
    // 获取色系信息（用于调试）
    getColorGroupInfo(colorValue: string) {
      const musicCandidates = this.colorMusicGroups[colorValue] || [];
      return {
        colorValue,
        candidateCount: musicCandidates.length,
        candidates: musicCandidates
      };
    }
    
    // 测试所有色系的音乐文件（用于调试和验证）
    async testAllMusicFiles() {
      console.log('🔍 开始测试所有音乐文件...');
      
      const actualFiles = [
        'red.mp3', 'pink1.mp3', 'blue1.mp3', 'green2.mp3', 
        'purple.mp3', 'yellow2.mp3', 'orange1.mp3', 'cyan.mp3',
        'lavender1.mp3', 'generic-background.mp3', '2.mp3', '3.mp3',
        'Nikolaj Egelund-Arrival Manor House.mp3', 'Painless Destiny-Lost control.mp3'
      ];
      
      let successCount = 0;
      let failCount = 0;
      
      for (const fileName of actualFiles) {
        const musicPath = `/colorball-music/${fileName}`;
        try {
          const response = await fetch(musicPath, { method: 'HEAD' }); // 只棄查头信息，不下载全文件
          if (response.ok) {
            console.log(`✅ 文件存在且可访问: ${fileName}`);
            successCount++;
          } else {
            console.warn(`⚠️ 文件无法访问: ${fileName} (HTTP ${response.status})`);
            failCount++;
          }
        } catch (error) {
          console.error(`❌ 文件检查失败: ${fileName}`, error);
          failCount++;
        }
      }
      
      console.log(`📈 音乐文件检查结果: 成功 ${successCount}个，失败 ${failCount}个`);
      
      if (successCount === actualFiles.length) {
        console.log('🎉 所有音乐文件都可正常访问！');
      }
      
      return { successCount, failCount, total: actualFiles.length };
    }
    stopMusic() {
      if (this.currentAudio) {
        this.currentAudio.pause();
        this.currentAudio.currentTime = 0;
        this.currentAudio = null;
      }
      this.isPlaying = false;
      this.removeVisualFeedback();
      this.currentPlayingBall = null;
      console.log('🛑 音乐播放已停止');
    }
    
    // 暂停/恢复当前音乐
    toggleMusic() {
      if (!this.currentAudio) {
        console.log('⚠️ 没有正在播放的音乐');
        return;
      }
      
      if (this.currentAudio.paused) {
        this.currentAudio.play();
        this.isPlaying = true;
        if (this.currentPlayingBall) {
          this.addVisualFeedback(this.currentPlayingBall);
        }
        console.log('▶️ 音乐恢复播放');
      } else {
        this.currentAudio.pause();
        this.isPlaying = false;
        this.removeVisualFeedback();
        console.log('⏸️ 音乐暂停');
      }
    }
    
    // 重新播放当前色系的随机音乐
    replayCurrentColor() {
      if (this.currentPlayingBall && this.currentPlayingBall.getAttribute) {
        const colorValue = this.currentPlayingBall.getAttribute('data-value');
        if (colorValue) {
          this.playColorMusic(colorValue, this.currentPlayingBall);
        }
      } else {
        console.log('⚠️ 没有当前播放的颜色球');
      }
    }
    
    // 获取播放状态
    getPlayingStatus() {
      return {
        isPlaying: this.isPlaying,
        currentTime: this.currentAudio && this.currentAudio.currentTime !== undefined ? this.currentAudio.currentTime : 0,
        duration: this.currentAudio && this.currentAudio.duration !== undefined ? this.currentAudio.duration : 0
      };
    }
    
    // 设置音量
    setVolume(volumeValue: number) {
      if (this.currentAudio && this.currentAudio.volume !== undefined) {
        this.currentAudio.volume = Math.max(0, Math.min(1, volumeValue || 0));
      }
    }
    

  }

  // 动效类型定义
  const singleEffects = [
    'effect-float', 'effect-hover', 'effect-bounce', 'effect-spin', 
    'effect-pulse', 'effect-swing', 'effect-shake', 'effect-glow', 
    'effect-drift', 'effect-breathe'
  ];
  
  const comboEffects = [
    // 原来8种组合特效
    'combo-tornado', 'combo-orbit', 'combo-bubble', 'combo-spiral',
    'combo-wave', 'combo-whirlpool', 'combo-constellation', 'combo-galaxy',
    // 新增8种小组合特效
    'combo-merge', 'combo-classify', 'combo-clover', 'combo-polar-star',
    'combo-big-dipper', 'combo-butterfly', 'combo-flower-bloom', 'combo-ripple'
  ];
  
  const largeComboEffects = [
    'large-combo-formation', 'large-combo-matrix', 'large-combo-supernova', 'large-combo-vortex',
    'large-combo-phoenix', 'large-combo-nebula', 'large-combo-symphony', 'large-combo-cosmos',
    'large-combo-meteor-shower', 'large-combo-time-warp'
  ];

  // 随机动效管理器
  class EffectManager {
    private balls: NodeListOf<HTMLElement>;
    private effectIntervals: Map<HTMLElement, NodeJS.Timeout> = new Map();
    private isActive: boolean = true;
    
    constructor(balls: NodeListOf<HTMLElement>) {
      this.balls = balls;
      this.initRandomEffects();
      this.startEffectCycle();
    }
    
    // 初始化随机动效分配
    initRandomEffects() {
      this.balls.forEach((ball, index) => {
        // 为每个球随机分配一个初始动效
        const randomEffect = this.getRandomEffect();
        this.applyEffect(ball, randomEffect);
        
        // 设置不同的延迟，让动效启动更自然
        setTimeout(() => {
          this.scheduleNextEffect(ball);
        }, Math.random() * 3000 + 1000); // 1-4秒的随机延迟
      });
    }
    
    // 获取随机动效
    getRandomEffect(): string {
      const allEffects = [...singleEffects, ...comboEffects];
      // 70% 概率使用单球动效，30% 概率使用组合动效
      const useCombo = Math.random() < 0.3;
      
      if (useCombo) {
        return comboEffects[Math.floor(Math.random() * comboEffects.length)];
      } else {
        return singleEffects[Math.floor(Math.random() * singleEffects.length)];
      }
    }
    
    // 应用动效到球
    applyEffect(ball: HTMLElement, effectClass: string) {
      // 清除之前的动效类
      [...singleEffects, ...comboEffects, ...largeComboEffects].forEach(effect => {
        ball.classList.remove(effect);
      });
      
      // 应用新动效
      ball.classList.add(effectClass);
    }
    
    // 安排下一个动效
    scheduleNextEffect(ball: HTMLElement) {
      if (!this.isActive) return;
      
      // 清除之前的定时器
      const existingInterval = this.effectIntervals.get(ball);
      if (existingInterval) {
        clearTimeout(existingInterval);
      }
      
      // 设置下一次动效变化的时间（8-20秒随机间隔）
      const delay = Math.random() * 12000 + 8000;
      
      const timeoutId = setTimeout(() => {
        const newEffect = this.getRandomEffect();
        this.applyEffect(ball, newEffect);
        this.scheduleNextEffect(ball); // 递归安排下一次
      }, delay);
      
      this.effectIntervals.set(ball, timeoutId);
    }
    
    // 启动动效循环系统
    startEffectCycle() {
      // 定期触发群体动效
      setInterval(() => {
        if (!this.isActive) return;
        
        const random = Math.random();
        
        // 15% 概率触发大组合特效（8球以上）
        if (random < 0.15) {
          this.triggerLargeComboEffect();
        }
        // 10% 概率触发小组合特效（3-6球）
        else if (random < 0.25) {
          this.triggerGroupEffect();
        }
      }, 12000); // 每12秒检查一次，更频繁的特效
    }
    
    // 触发群体特效
    triggerGroupEffect() {
      const groupEffects = [
        // 经典特效
        'combo-tornado', 'combo-whirlpool', 'combo-constellation',
        // 新增创意特效
        'combo-merge', 'combo-classify', 'combo-clover', 'combo-polar-star',
        'combo-big-dipper', 'combo-butterfly', 'combo-flower-bloom', 'combo-ripple'
      ];
      const selectedEffect = groupEffects[Math.floor(Math.random() * groupEffects.length)];
      
      // 随机选择3-6个球进行群体动效
      const numBalls = Math.floor(Math.random() * 4) + 3;
      const ballsArray = Array.from(this.balls);
      const selectedBalls = [];
      
      for (let i = 0; i < numBalls; i++) {
        const randomIndex = Math.floor(Math.random() * ballsArray.length);
        const ball = ballsArray.splice(randomIndex, 1)[0];
        if (ball) selectedBalls.push(ball);
      }
      
      // 应用群体动效
      selectedBalls.forEach((ball, index) => {
        setTimeout(() => {
          this.applyEffect(ball, selectedEffect);
          
          // 3秒后恢复正常动效
          setTimeout(() => {
            const normalEffect = this.getRandomEffect();
            this.applyEffect(ball, normalEffect);
          }, 3000);
        }, index * 200); // 每个球延迟200毫秒启动
      });
      
      console.log(`🌟 触发群体特效: ${selectedEffect}，影响 ${selectedBalls.length} 个球`);
    }
    
    // 触发大组合特效（8球以上）
    triggerLargeComboEffect() {
      const selectedEffect = largeComboEffects[Math.floor(Math.random() * largeComboEffects.length)];
      
      // 随机选择8-15个球进行大组合特效
      const numBalls = Math.min(Math.floor(Math.random() * 8) + 8, this.balls.length);
      const ballsArray = Array.from(this.balls);
      const selectedBalls = [];
      
      for (let i = 0; i < numBalls; i++) {
        const randomIndex = Math.floor(Math.random() * ballsArray.length);
        const ball = ballsArray.splice(randomIndex, 1)[0];
        if (ball) selectedBalls.push(ball);
      }
      
      // 应用大组合特效，使用波浪式启动
      selectedBalls.forEach((ball, index) => {
        setTimeout(() => {
          this.applyEffect(ball, selectedEffect);
          
          // 5秒后恢复正常动效
          setTimeout(() => {
            const normalEffect = this.getRandomEffect();
            this.applyEffect(ball, normalEffect);
          }, 5000);
        }, index * 150); // 每个球延迟150毫秒启动，更快的波浪效果
      });
      
      console.log(`🎆 触发大组合特效: ${selectedEffect}，影响 ${selectedBalls.length} 个球！`);
    }
    
    // 暂停动效系统
    pause() {
      this.isActive = false;
      this.effectIntervals.forEach(interval => clearTimeout(interval));
      this.effectIntervals.clear();
    }
    
    // 恢复动效系统
    resume() {
      this.isActive = true;
      this.initRandomEffects();
    }
  }

  // 初始化颜色球功能
  function initColorBalls() {
    const balls = document.querySelectorAll('.color-ball') as NodeListOf<HTMLElement>;
    const currentTheme = localStorage.getItem('theme-color') || 'pink';
    
    // 初始化动效管理器
    const effectManager = new EffectManager(balls);
    
    // 初始化色系音乐播放器
    const musicPlayer = new ColorBallMusicPlayer();
    
    // 设置初始选中状态
    balls.forEach(ball => {
      const themeValue = ball.getAttribute('data-value');
      if (themeValue === currentTheme) {
        ball.classList.add('selected');
      }
      
      // 点击事件 - 新的色系音乐播放逻辑
      ball.addEventListener('click', function(event) {
        // 防止事件冒泡
        event.stopPropagation();
        
        const colorValue = ball.getAttribute('data-value');
        const colorName = ball.getAttribute('data-name');
        
        if (!colorValue || !colorName) {
          console.warn('⚠️ 颜色球缺少必要属性');
          return;
        }
        
        // 添加点击效果
        ball.classList.add('clicked');
        setTimeout(() => ball.classList.remove('clicked'), 400);
        
        // 双击检测
        const now = Date.now();
        const lastClick = (ball as any).lastClickTime || 0;
        const isDoubleClick = now - lastClick < 300;
        (ball as any).lastClickTime = now;
        
        if (isDoubleClick) {
          // 双击：控制音乐播放/暂停
          console.log('💆 检测到双击，控制音乐播放');
          // 暂时禁用双击功能，避免类型错误
          console.log('⚠️ 双击功能暂时禁用');
        } else {
          // 单击：播放色系音乐 + 主题切换
          setTimeout(async () => {
            // 检查是否真的是单击
            if (Date.now() - (ball as any).lastClickTime >= 250) {
              
              // 1. 播放该色系的随机音乐
              console.log(`🎨 播放 ${colorName} (${colorValue}) 色系音乐`);
              musicPlayer.playColorMusic(colorValue, ball);
              
              // 2. 更新主题颜色
              // 移除所有选中状态
              balls.forEach(b => b.classList.remove('selected'));
              // 添加当前选中状态
              ball.classList.add('selected');
              
              const colorHex = ball.getAttribute('data-color');
              if (colorHex) {
                document.documentElement.setAttribute('data-theme-color', colorValue!);
                localStorage.setItem('theme-color', colorValue!);
                
                // 触发主题颜色变更事件
                document.dispatchEvent(new CustomEvent('theme-color-changed', {
                  detail: { 
                    color: colorValue!,
                    colorHex: colorHex!,
                    colorName: colorName!
                  }
                }));
                
                console.log(`🎨 切换到主题颜色: ${colorName!} (${colorHex!})`);
              }
            }
          }, 250);
        }
      });
    });
    
    console.log(`🎉 初始化了18个颜色球和色系音乐播放器！`);

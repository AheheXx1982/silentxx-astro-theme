// 生成18个颜色球的随机分布位置（在圆盘内部）
function generateRandomPositions(): Position[] {
  const positions: Position[] = [];
  const centerX = 50; // 圆盘中心X坐标（%）
  const centerY = 50; // 圆盘中心Y坐标（%）
  const diskRadius = 35; // 圆盘半径（%）
  const centerDeadZone = 12; // 中心死区半径，避免遮挡幽灵图标
  const minDistance = 8; // 球之间最小距离
  
  for (let i = 0; i < 18; i++) {
    let position: Position;
    let attempts = 0;
    
    do {
      // 随机生成角度和距离
      const angle = Math.random() * Math.PI * 2;
      const distance = centerDeadZone + Math.random() * (diskRadius - centerDeadZone);
      
      // 计算位置
      const x = centerX + Math.cos(angle) * distance;
      const y = centerY + Math.sin(angle) * distance;
      
      position = { left: x, top: y };
      attempts++;
    } while (
      attempts < 100 && // 防止无限循环
      (
        // 检查是否距离其他球太近
        positions.some(existingPos => {
          const dx = position.left - existingPos.left;
          const dy = position.top - existingPos.top;
          const distance = Math.sqrt(dx * dx + dy * dy);
          return distance < minDistance;
        })
      )
    );
    
    positions.push(position);
  }
  
  return positions;
}

const ballPositions = generateRandomPositions();

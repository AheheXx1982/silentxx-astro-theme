  // 页面切换时清理管理器
  function cleanupManagers() {
    const existingEffectManager = (window as any).colorBallEffectManager;
    if (existingEffectManager && typeof existingEffectManager.pause === 'function') {
      existingEffectManager.pause();
      (window as any).colorBallEffectManager = null;
    }
    
    const existingMusicPlayer = (window as any).colorBallMusicPlayer;
    if (existingMusicPlayer && typeof existingMusicPlayer.stopMusic === 'function') {
      existingMusicPlayer.stopMusic();
      (window as any).colorBallMusicPlayer = null;
    }
  }

  // Astro页面切换时重新初始化
  document.addEventListener('astro:page-load', () => {
    cleanupManagers();
    initColorBalls();
  });
  
  // 页面卸载时清理
  document.addEventListener('astro:before-preparation', cleanupManagers);
  window.addEventListener('beforeunload', cleanupManagers);
  
  // 页面加载时初始化
  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', () => {
      cleanupManagers();
      initColorBalls();
    });
  } else {
    cleanupManagers();
    initColorBalls();
  }

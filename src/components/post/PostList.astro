---
import EmptySvg from '@components/svg/EmptySvg';
import Divider from '@components/ui/divider';
import { defaultCoverList } from '@constants/site-config';
import { getPostCoverImage } from '@lib/content';
import { getLanguageFromAstroUrl, getUIText } from '@lib/i18n';
import type { Page } from 'astro';
import { shuffle } from 'es-toolkit';
import type { BlogPost } from 'types/blog';
import CategoryCards from './CategoryCards.astro';
import Paginator from './Paginator.astro';
import PostItemCard from './PostItemCard.astro';

interface Props {
  posts?: BlogPost[];
  page?: Page<BlogPost>;
  showPaginator?: boolean;
  lang?: string;
}

const { posts, page, showPaginator = true, lang } = Astro.props;
const currentLang = lang || getLanguageFromAstroUrl(Astro.url);
const uiText = getUIText(currentLang as 'zh' | 'en');
// 为每篇文章生成对应分类的随机封面图片
const covers =
  posts?.map((post) => {
    // 使用与文章详情页相同的函数获取封面图片，确保一致性
    return getPostCoverImage(post);
  }) || [];
---

<Divider>{uiText.postList}</Divider>
{
  !posts?.length && (
    <div class="text-foreground/30 flex flex-col items-center gap-2">
      <EmptySvg className="fill-foreground/20" />
      <span>还没有发表文章哦～</span>
    </div>
  )
}
{
  posts && posts?.length > 0 && (
    <>
      <div class="flex flex-col">
        {posts.map((post, index) => (
          <div class="p-4">
            <PostItemCard data={post} leftClip={index % 2 === 0} randomCover={covers[index]} lang={currentLang} />
          </div>
        ))}
      </div>
      {showPaginator && page && <Paginator page={page} lang={currentLang} />}
    </>
  )
}
<Divider>{uiText.featuredCategories}</Divider>
<CategoryCards lang={currentLang} />

---
import { siteConfig } from '@constants/site-config';
import { parseDate } from '@lib/datetime';
import { Icon } from 'astro-icon/components';
import readingTime from 'reading-time';
import type { BlogPost } from 'types/blog';
import WaveSvg from './wave';
import JSBgScript from './JSBgScript.astro';
import { getSiteConfig } from '@lib/i18n';

export interface CoverProps {
  data?: BlogPost;
  title?: string;
  lang?: string; // 添加语言属性
  showSiteInfo?: boolean; // 添加显示站点信息的属性
}

const { data, title, lang = 'zh', showSiteInfo = false } = Astro.props as CoverProps;

const { date, title: dataTitle } = data?.data ?? {};

const readState = readingTime(data?.body ?? '');

// 为文章详情页面添加封面图片逻辑
import { getPostCoverImage } from '@lib/content';
const coverImage = data ? getPostCoverImage(data) : '/img/banner.webp';

// 获取多语言站点配置
const localizedSiteConfig = getSiteConfig(lang as any);
---

<div class="relative flex h-[60vh] max-h-[35rem] overflow-hidden">
  <div class="absolute inset-0 h-full bg-black/40"></div>
  <div class="absolute inset-0 bottom-[8vh] flex flex-col items-center justify-center px-5 text-white">
    {
      data || (title && !showSiteInfo) ? (
        <>
          <h1 class="shadow-text word-break text-4.5xl text-center font-bold md:text-2xl">{dataTitle ?? title}</h1>
          {data && (
            <p class="mt-3 flex items-center justify-center gap-4 md:text-xs">
              <span class="flex items-center gap-1">
                <Icon name="fa6-solid:calendar-days" />
                发表于 {parseDate(date ?? '', 'YYYY-MM-DD')}
              </span>
              <span class="flex items-center gap-1">
                <Icon name="fa6-solid:pen-nib" /> {readState?.words} 字
              </span>
              <span class="flex items-center gap-1">
                <Icon name="fa6-solid:clock" />
                {readState?.text}
              </span>
            </p>
          )}
        </>
      ) : (
        <>
          <h1 class="shadow-text font-noto text-5.5xl/[1.2] xs:text-4xl">{localizedSiteConfig?.title}</h1>
          <p class="shadow-text xs:text-xs mt-5 text-sm">= {localizedSiteConfig?.subtitle} =</p>
        </>
      )
    }
  </div>
  <div class="relative -z-10 h-full min-h-[15rem] w-full" id="banner-box">
    <img src={coverImage} alt="cover" class="h-full w-full object-cover" />
  </div>
  <WaveSvg />
</div>

{siteConfig?.enableJSGridCover && <JSBgScript />}

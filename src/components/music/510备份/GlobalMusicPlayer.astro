    // 更新单个眼睛的状态
    updateSingleEyeState(eyeElement, eyeType) {
      const pupil = eyeElement.querySelector('.eye-pupil');
      const eyeLid = eyeElement.querySelector('.eye-lid');

      if (this.isPlaying) {
        // 播放时的动画效果
        if (pupil) {
          // 添加眼珠转动动画
          pupil.classList.add('looking-around');

          // 智能眨眼：根据音乐节拍模拟眨眼
          this.scheduleSmartBlink(pupil);

          // 根据眼睛类型添加特殊效果
          if (eyeType === 'minimize') {
            // 最小化按钮的眼睛：更活跃的转动
            pupil.classList.add('active-looking');

            // 添加音乐感应振动效果
            if (Math.random() > 0.6) {
              eyeElement.classList.add('music-vibrating');
              setTimeout(
                () => {
                  eyeElement.classList.remove('music-vibrating');
                },
                1500 + Math.random() * 1000,
              );
            }
          } else if (eyeType === 'close') {
            // 关闭按钮的眼睛：更谨慎的观察
            pupil.classList.add('watchful-looking');

            // 偶尔的警觉效果
            if (Math.random() > 0.8) {
              eyeElement.classList.add('alert-pulse');
              setTimeout(() => {
                eyeElement.classList.remove('alert-pulse');
              }, 2000);
            }
          }
        }

        // 眼睑的微妙动画
        if (eyeLid) {
          eyeLid.classList.add('subtle-movement');
        }
      } else {
        // 暂停时的状态
        if (pupil) {
          pupil.classList.remove('looking-around', 'active-looking', 'watchful-looking', 'smart-blink');
        }

        if (eyeLid) {
          eyeLid.classList.remove('subtle-movement');
        }

        eyeElement.classList.remove('music-vibrating', 'alert-pulse');

        // 暂停时的缓慢眨眼
        this.scheduleRestBlink(pupil);
      }
    }

    // 智能眨眼调度（播放时）
    scheduleSmartBlink(pupil) {
      if (!pupil || !this.isPlaying) return;

      // 清除之前的眨眼定时器
      if (pupil._blinkTimer) {
        clearTimeout(pupil._blinkTimer);
      }

      // 模拟音乐节拍的眨眼（2-6秒间隔）
      const blinkInterval = 2000 + Math.random() * 4000;

      pupil._blinkTimer = setTimeout(() => {
        if (pupil && this.isPlaying) {
          pupil.classList.add('smart-blink');

          // 眨眼持续时间
          setTimeout(
            () => {
              if (pupil) {
                pupil.classList.remove('smart-blink');
                // 递归调度下一次眨眼
                this.scheduleSmartBlink(pupil);
              }
            },
            300 + Math.random() * 200,
          );
        }
      }, blinkInterval);
    }

    // 休息时的眨眼调度（暂停时）
    scheduleRestBlink(pupil) {
      if (!pupil || this.isPlaying) return;

      // 清除之前的眨眼定时器
      if (pupil._restBlinkTimer) {
        clearTimeout(pupil._restBlinkTimer);
      }

      // 暂停时较慢的眨眼（5-10秒间隔）
      const restBlinkInterval = 5000 + Math.random() * 5000;

      pupil._restBlinkTimer = setTimeout(() => {
        if (pupil && !this.isPlaying) {
          pupil.classList.add('rest-blink');

          setTimeout(() => {
            if (pupil) {
              pupil.classList.remove('rest-blink');
              // 递归调度下一次休息眨眼
              this.scheduleRestBlink(pupil);
            }
          }, 400);
        }
      }, restBlinkInterval);
    }

    // 触发眼睛动画
    triggerEyeAnimation() {
      // 这个函数用于触发眼睛的特殊动画效果
      const allEyes = document.querySelectorAll('[id*="eye"]');

      allEyes.forEach((eye) => {
        if (this.isPlaying) {
          // 播放时添加活跃动画
          eye.classList.add('music-active');

          // 随机触发特殊效果
          if (Math.random() > 0.7) {
            eye.classList.add('music-pulse');
            setTimeout(() => {
              eye.classList.remove('music-pulse');
            }, 1000);
          }
        } else {
          // 暂停时移除活跃动画
          eye.classList.remove('music-active', 'music-pulse');
        }
      });
    }

    // 清理眼睛动画定时器
    cleanupEyeAnimations() {
      const allPupils = document.querySelectorAll('.eye-pupil');
      allPupils.forEach((pupil) => {
        if (pupil._blinkTimer) {
          clearTimeout(pupil._blinkTimer);
        }
        if (pupil._restBlinkTimer) {
          clearTimeout(pupil._restBlinkTimer);
        }
      });
    }

    // 更新唱针位置（整合旧播放器的精确控制）
    updateTonearmPosition(isPlaying) {
      const tonearm = document.getElementById('tonearm');
      if (!tonearm) return;

      // 强制重绘以确保动画正确执行
      tonearm.offsetHeight;

      if (isPlaying) {
        // 播放时：唱针缓慢移动到唱片上方（向内），精确对准唱片边缘
        setTimeout(() => {
          tonearm.style.transform = 'rotate(-28deg)'; // 更深的角度，确保接触唱片
        }, 100);
      } else {
        // 停止时：唱针缓慢移动到外侧（向外），完全离开唱片
        setTimeout(() => {
          tonearm.style.transform = 'rotate(18deg)'; // 向外的角度
        }, 150);
      }
    }

    updateProgressDisplay() {
      if (!this.audioElement) return;

      const currentTime = this.audioElement.currentTime || 0;
      const duration = this.audioElement.duration || 0;

      const currentTimeDisplay = document.getElementById('current-time');
      const totalTimeDisplay = document.getElementById('total-time');

      if (currentTimeDisplay) {
        currentTimeDisplay.textContent = this.formatTime(currentTime);
      }

      if (totalTimeDisplay) {
        totalTimeDisplay.textContent = this.formatTime(duration);
      }

      const progressBar = document.getElementById('progress-bar');
      if (progressBar && duration > 0) {
        const percentage = (currentTime / duration) * 100;
        progressBar.style.width = percentage + '%';
      }
    }

    formatTime(seconds) {
      const minutes = Math.floor(seconds / 60);
      const remainingSeconds = Math.floor(seconds % 60);
      return `${minutes}:${remainingSeconds.toString().padStart(2, '0')}`;
    }


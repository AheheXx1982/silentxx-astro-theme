---

<div id="global-music-player" data-astro-transition-persist="music-player"></div>

<script is:inline>
  class GlobalMusicPlayer {
    constructor() {
      console.log('GlobalMusicPlayer 构造函数被调用');
      this.isPlaying = false;
      this.isMinimized = false;
      this.currentTrack = null;
      this.playlist = [];
      this.currentTrackIndex = 0;
      this.audioElement = null;
      this.playerPosition = null;
      console.log('GlobalMusicPlayer 属性初始化完成，开始调用 init()');
      this.init();
    }

    // 处理音频文件路径，确保在所有页面路径下都能正确解析
    resolveAudioPath(src) {
      if (!src) return '';

      // 如果已经是完整的URL，直接返回
      if (src.startsWith('http://') || src.startsWith('https://')) {
        return src;
      }

      // 确保路径以 / 开头
      if (!src.startsWith('/')) {
        src = '/' + src;
      }

      // 使用encodeURIComponent正确编码路径中的特殊字符
      // 但要确保路径分隔符不被编码
      const parts = src.split('/');
      const encodedParts = parts.map((part, index) => {
        // 第一个元素是空字符串（因为路径以/开头），不需要编码
        if (index === 0) return part;
        // 对文件名部分进行编码，处理特殊字符（包括+号）
        return encodeURIComponent(part);
      });
      const encodedSrc = encodedParts.join('/');

      // 获取当前页面的基础路径
      const basePath = window.location.origin;

      // 返回完整的绝对路径
      return basePath + encodedSrc;
    }

    async init() {
      try {
        console.log('GlobalMusicPlayer init() 方法开始执行');
        // 将播放器实例暴露到window对象，供HTML onclick使用
        window.musicPlayer = this;
        console.log('window.musicPlayer 已设置:', window.musicPlayer);

        // 加载播放列表
        const response = await fetch('/music/playlist.json');
        const data = await response.json();
        this.playlist = data.playlist || [];

        // 创建音频元素
        this.audioElement = new Audio();
        this.audioElement.volume = 0.7;
        this.setupAudioEvents();

        // 恢复状态
        this.restorePlayerState();

        // 设置默认曲目
        if (this.playlist.length > 0 && !this.currentTrack) {
          this.currentTrack = this.playlist[0];
          this.currentTrackIndex = 0;
          this.audioElement.src = this.resolveAudioPath(this.currentTrack.src);
        }

        // 只有在有保存的状态时才自动创建UI，否则等待手动触发
        if (this.hasPlayerState()) {
          this.createPlayerUI();
          this.setupEvents();
        }

        console.log('音乐播放器初始化成功, 播放列表:', this.playlist.length, '首');
      } catch (error) {
        console.error('播放列表加载失败:', error);
        // 即使加载失败也不自动创建UI
      }
    }

    setupAudioEvents() {
      if (!this.audioElement) return;

      this.audioElement.addEventListener('ended', () => {
        this.nextTrack();
      });

      // 添加播放和暂停事件监听器确保状态同步
      this.audioElement.addEventListener('play', () => {
        console.log('🎵 音频开始播放事件');
        this.isPlaying = true;
        this.updateUI();
        this.savePlayerState();
      });

      this.audioElement.addEventListener('pause', () => {
        console.log('⏸️ 音频暂停事件');
        this.isPlaying = false;
        this.updateUI();
        this.savePlayerState();
      });

      // 添加音频加载完成事件
      this.audioElement.addEventListener('loadeddata', () => {
        console.log('📁 音频数据加载完成');
        this.updateProgressDisplay();
      });

      // 添加播放进度更新事件
      this.audioElement.addEventListener('timeupdate', () => {
        this.updateProgressDisplay();
      });

      this.audioElement.addEventListener('error', (e) => {
        console.error('音频播放错误:', e);
        console.error('错误详情:', {
          code: e.target.error?.code,
          message: e.target.error?.message,
          src: e.target.src,
        });
        this.isPlaying = false;
        this.updateUI();
      });

      this.audioElement.addEventListener('timeupdate', () => {
        this.updateProgressDisplay();
      });
    }

    restorePlayerState() {
      try {
        const savedState = localStorage.getItem('musicPlayerDetailedState');
        if (savedState) {
          const state = JSON.parse(savedState);
          if (state.playlist && state.playlist.length > 0) {
            this.playlist = state.playlist;
            this.currentTrackIndex = state.currentTrackIndex || 0;
            this.currentTrack = state.currentTrack || this.playlist[this.currentTrackIndex];
            this.isPlaying = state.isPlaying || false;
            this.isMinimized = state.isMinimized || false;

            if (this.currentTrack && this.audioElement) {
              this.audioElement.src = this.resolveAudioPath(this.currentTrack.src);
              this.audioElement.currentTime = state.currentTime || 0;
              this.audioElement.volume = state.volume || 0.7;
            }
          }
        }
      } catch (error) {
        console.error('状态恢复失败:', error);
      }
    }

    hasPlayerState() {
      try {
        const savedState = localStorage.getItem('musicPlayerDetailedState');
        if (!savedState) return false;

        const state = JSON.parse(savedState);
        // 只有明确标记为应该显示播放器时才返回true
        // 这里我们检查是否有播放器显示标志，而不仅仅是播放列表
        return state.shouldShowPlayer === true;
      } catch (error) {
        return false;
      }
    }

    showPlayer() {
      // 如果播放器已经存在，直接显示
      const existingPlayer = document.getElementById('music-player');
      if (existingPlayer) {
        existingPlayer.style.display = 'block';
        return;
      }

      // 创建播放器UI
      this.createPlayerUI();
      this.setupEvents();
      console.log('播放器已显示');
    }

    savePlayerState() {
      try {
        const state = {
          isPlaying: this.isPlaying,
          currentTrackIndex: this.currentTrackIndex,
          currentTrack: this.currentTrack,
          currentTime: this.audioElement?.currentTime || 0,
          volume: this.audioElement?.volume || 0.7,
          playlist: this.playlist,
          isMinimized: this.isMinimized,
          timestamp: Date.now(),
          shouldShowPlayer: true,
        };
        localStorage.setItem('musicPlayerDetailedState', JSON.stringify(state));
      } catch (error) {
        console.error('状态保存失败:', error);
      }
    }

    createPlayerUI() {
      const container = document.getElementById('global-music-player');
      if (!container) return;

      container.innerHTML = `
        <div id="music-player" class="fixed bg-gradient-to-br from-amber-900/20 to-amber-700/20 backdrop-blur-md border border-amber-500/30 shadow-2xl z-50 group" style="width: 300px; height: 300px; pointer-events: auto; border-radius: 50%; right: 20px; top: 50%; transform: translateY(-50%);">
          <div class="relative w-full h-full flex items-center justify-center">
            <!-- 拖拽区域（透明且在顶部，不包含按钮区域） -->
            <div id="drag-area" class="absolute top-0 left-0 right-0 h-12 z-10 cursor-move" style="background: transparent; border-radius: 50%;" title="拖拽移动播放器"></div>
            
            <!-- 唱片机主体（圆形设计） -->
            <div class="relative flex items-center justify-center">
              <!-- 外围控制按钮圆环 -->
              <div class="absolute w-64 h-64 rounded-full border-2 border-amber-500/50 z-10">
                <!-- 上一首按钮 -->
                <button id="prev-btn" class="absolute top-0 left-1/2 transform -translate-x-1/2 -translate-y-1/2 w-10 h-10 bg-amber-600 hover:bg-amber-700 rounded-full flex items-center justify-center transition-colors shadow-lg" style="pointer-events: auto; cursor: pointer;" onclick="window.musicPlayer?.previousTrack(); console.log('上一首按钮点击');">
                  <svg class="w-5 h-5 text-white" fill="currentColor" viewBox="0 0 20 20">
                    <path fill-rule="evenodd" d="M15.445 5.168A1 1 0 0117 6v8a1 1 0 01-1.555.832L10 11.202V14a1 1 0 01-1.555.832l-6-4a1 1 0 010-1.664l6-4A1 1 0 0110 6v2.798l5.445-3.63z" clip-rule="evenodd"></path>
                  </svg>
                </button>
                
                <!-- 播放列表按钮 -->
                <button id="playlist-btn" class="absolute top-1/2 right-0 transform translate-x-1/2 -translate-y-1/2 w-10 h-10 bg-blue-600 hover:bg-blue-700 rounded-full flex items-center justify-center transition-colors shadow-lg" style="pointer-events: auto; cursor: pointer;" onclick="window.musicPlayer?.showPlaylist(); console.log('播放列表按钮点击');">
                  <svg class="w-5 h-5 text-white" fill="currentColor" viewBox="0 0 20 20">
                    <path d="M3 4a1 1 0 011-1h12a1 1 0 110 2H4a1 1 0 01-1-1zM3 8a1 1 0 011-1h12a1 1 0 110 2H4a1 1 0 01-1-1zM4 11a1 1 0 100 2h8a1 1 0 100-2H4z"></path>
                  </svg>
                </button>
                
                <!-- 下一首按钮 -->
                <button id="next-btn" class="absolute bottom-0 left-1/2 transform -translate-x-1/2 translate-y-1/2 w-10 h-10 bg-amber-600 hover:bg-amber-700 rounded-full flex items-center justify-center transition-colors shadow-lg" style="pointer-events: auto; cursor: pointer;" onclick="window.musicPlayer?.nextTrack(); console.log('下一首按钮点击');">
                  <svg class="w-5 h-5 text-white" fill="currentColor" viewBox="0 0 20 20">
                    <path fill-rule="evenodd" d="M4.555 5.168A1 1 0 003 6v8a1 1 0 001.555.832L10 11.202V14a1 1 0 001.555.832l6-4a1 1 0 000-1.664l-6-4A1 1 0 0010 6v2.798l-5.445-3.63z" clip-rule="evenodd"></path>
                  </svg>
                </button>
                
                <!-- 播放按钮 -->
                <button id="play-btn" class="absolute top-1/2 left-0 transform -translate-x-1/2 -translate-y-1/2 w-12 h-12 bg-green-600 hover:bg-green-700 rounded-full flex items-center justify-center transition-colors shadow-lg" style="pointer-events: auto; cursor: pointer;" onclick="window.musicPlayer?.togglePlay(); console.log('播放按钮点击');">
                  <svg id="play-icon" class="w-6 h-6 text-white" fill="currentColor" viewBox="0 0 20 20">
                    <path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zM9.555 7.168A1 1 0 008 8v4a1 1 0 001.555.832l3-2a1 1 0 000-1.664l-3-2z" clip-rule="evenodd"></path>
                  </svg>
                </button>
              </div>
              
              <!-- 环绕式控制按钮 -->
              <div class="absolute inset-0 pointer-events-none">
                <!-- 最小化按钮 - 环绕在播放器左上方 -->
                <button id="minimize-btn" class="absolute top-2 left-2 w-8 h-8 rounded-full bg-amber-700/80 backdrop-blur-sm border border-amber-500/50 flex items-center justify-center transition-all duration-300 hover:bg-amber-600/90 hover:scale-110 group pointer-events-auto cursor-pointer z-20 eye-button" title="最小化" style="pointer-events: auto; cursor: pointer;" onclick="window.musicPlayer?.minimizePlayer(); console.log('最小化按钮点击');">
                  <!-- 逼真的眼睛 -->
                  <div class="realistic-eye" id="minimize-eye" style="width:20px;height:20px;background:#ffffff;border-radius:50%;border:2px solid #22c55e;display:flex;align-items:center;justify-content:center;position:relative;box-shadow:0 2px 6px rgba(0,0,0,0.1), inset 0 1px 2px rgba(255,255,255,0.9);">
                    <div class="eye-pupil" style="width:8px;height:8px;background:#000000;border-radius:50%;position:absolute;top:50%;left:50%;transform:translate(-50%,-50%);transition:all 0.3s ease;">
                      <div class="eye-highlight" style="position:absolute;top:20%;left:30%;width:2px;height:2px;background:rgba(255,255,255,0.9);border-radius:50%;"></div>
                    </div>
                  </div>
                </button>
                
                <!-- 关闭按钮 - 环绕在播放器右上方 -->
                <button id="close-btn" class="absolute top-2 right-2 w-8 h-8 rounded-full bg-amber-700/80 backdrop-blur-sm border border-amber-500/50 flex items-center justify-center transition-all duration-300 hover:bg-amber-600/90 hover:scale-110 group pointer-events-auto cursor-pointer z-20 eye-button" title="关闭" style="pointer-events: auto; cursor: pointer;" onclick="window.musicPlayer?.closePlayer(); console.log('关闭按钮点击');">
                  <!-- 逼真的眼睛 -->
                  <div class="realistic-eye" id="close-eye" style="width:20px;height:20px;background:#ffffff;border-radius:50%;border:2px solid #22c55e;display:flex;align-items:center;justify-content:center;position:relative;box-shadow:0 2px 6px rgba(0,0,0,0.1), inset 0 1px 2px rgba(255,255,255,0.9);">
                    <div class="eye-pupil" style="width:8px;height:8px;background:#000000;border-radius:50%;position:absolute;top:50%;left:50%;transform:translate(-50%,-50%);transition:all 0.3s ease;">
                      <div class="eye-highlight" style="position:absolute;top:20%;left:30%;width:2px;height:2px;background:rgba(255,255,255,0.9);border-radius:50%;"></div>
                    </div>
                  </div>
                </button>
              </div>
              
              <!-- 唱针臂（保留正确的动画效果） -->
              <div id="tonearm" class="absolute top-4 right-8 z-30 transition-transform duration-1000 ease-in-out origin-bottom-right">
                <div class="relative">
                  <!-- 唱针臂主体（采用旧播放器的金属渐变） -->
                  <div class="w-1 h-16 bg-gradient-to-b from-silver-400 to-silver-600 rounded-full shadow-lg transform rotate-12"></div>
                  <!-- 唱针头（金色设计） -->
                  <div class="absolute -bottom-1 -left-0.5 w-2 h-3 bg-gradient-to-b from-gold-400 to-gold-600 rounded-full shadow-md"></div>
                  <!-- 唱针臂支点 -->
                  <div class="absolute -top-2 -left-1 w-3 h-3 bg-silver-500 rounded-full shadow-lg"></div>
                </div>
              </div>
            
              <!-- 唱片区域（使用圆形设计） -->
              <div class="relative">
                <!-- 唱片（采用圆形设计） -->
                <div id="vinyl-record" class="relative w-40 h-40 rounded-full bg-gradient-to-br from-gray-900 via-gray-800 to-black shadow-2xl transition-transform duration-300 ease-out">
                  <!-- 唱片纹理（多层同心圆） -->
                  <div class="absolute inset-2 rounded-full border-2 border-gray-700/50"></div>
                  <div class="absolute inset-4 rounded-full border border-gray-600/30"></div>
                  <div class="absolute inset-6 rounded-full border border-gray-600/20"></div>
                  <div class="absolute inset-8 rounded-full border border-gray-600/10"></div>
                  
                  <!-- 唱片标签（圆形设计） -->
                  <div id="record-label" class="absolute top-1/2 left-1/2 transform -translate-x-1/2 -translate-y-1/2 w-16 h-16 rounded-full bg-gradient-to-br from-red-600 to-red-800 flex flex-col items-center justify-center text-white text-xs shadow-lg">
                    <div id="song-title-label" class="font-bold text-center px-1 truncate w-full text-[8px]">${this.currentTrack ? this.currentTrack.title : '未选择'}</div>
                    <div id="artist-label" class="text-[6px] opacity-75 text-center px-1 truncate w-full mt-0.5">${this.currentTrack ? this.currentTrack.artist : '音乐'}</div>
                  </div>
                  
                  <!-- 中心孔 -->
                  <div class="absolute top-1/2 left-1/2 transform -translate-x-1/2 -translate-y-1/2 w-2 h-2 bg-black rounded-full shadow-inner"></div>
                </div>
              </div>
            </div>
            
            <!-- 进度条（保持美观设计，放在底部） -->
            <div class="absolute bottom-4 left-1/2 transform -translate-x-1/2 w-3/4">
              <div class="flex justify-between text-xs text-amber-200 mb-1">
                <span id="current-time">0:00</span>
                <span id="total-time">0:00</span>
              </div>
              <div id="progress-container" class="w-full bg-amber-900/30 rounded-full h-1 cursor-pointer">
                <div id="progress-bar" class="bg-amber-500 h-1 rounded-full transition-all duration-300" style="width: 0%"></div>
              </div>
            </div>
          </div>
        </div>
      `;

      // 获取刚创建的播放器元素
      const player = document.getElementById('music-player');

      // 创建完成后立即更新UI状态
      setTimeout(() => {
        this.updateUI();
      }, 100);

      // 恢复播放器位置或设置默认位置
      if (player) {
        if (this.playerPosition && this.playerPosition.isDocked) {
          // 恢复吸附状态
          console.log('恢复吸附状态:', this.playerPosition);
          player.style.left = this.playerPosition.left + 'px';
          player.style.top = this.playerPosition.top + 'px';
          player.style.right = 'auto';
          player.style.bottom = 'auto';
          player.style.transform = 'none';
          player.classList.add('docked', `docked-${this.playerPosition.dockedSide}`);
        } else if (this.playerPosition && !this.playerPosition.isDocked) {
          // 恢复普通位置
          console.log('恢复普通位置:', this.playerPosition);
          player.style.left = this.playerPosition.left + 'px';
          player.style.top = this.playerPosition.top + 'px';
          player.style.right = 'auto';
          player.style.bottom = 'auto';
          player.style.transform = 'none';
        } else {
          // 默认位置：右侧中间
          const defaultLeft = window.innerWidth - 320; // 距离右边界20px
          const defaultTop = (window.innerHeight - 320) / 2; // 垂直居中
          player.style.left = defaultLeft + 'px';
          player.style.top = defaultTop + 'px';
          player.style.right = 'auto';
          player.style.bottom = 'auto';
          player.style.transform = 'none';

          // 保存默认位置
          this.playerPosition = {
            left: defaultLeft,
            top: defaultTop,
            isDocked: false,
          };
        }
      }
    }

    // 简化的事件设置（仅用于拖拽和进度条）
    setupEvents() {
      console.log('设置简化事件');

      // 只设置拖拽和进度条事件，按钮事件由HTML onclick处理
      const progressContainer = document.getElementById('progress-container');
      const player = document.getElementById('music-player');

      if (progressContainer) {
        progressContainer.addEventListener('click', (e) => this.seekTo(e));
      }

      if (player) {
        // 为最大化播放器也启用吸附功能
        this.makeDraggableWithDocking(player);
      }

      console.log('简化事件设置完成');
    }

    makeDraggable(element) {
      let isDragging = false;
      let startX, startY, startLeft, startTop;

      // 对于最小化播放器，整个容器都可以拖拽
      const draggableArea = element.querySelector('[data-draggable="true"]') || element;

      draggableArea.addEventListener('mousedown', (e) => {
        // 如果点击的是按钮，不启动拖拽
        if (e.target.closest('button')) return;

        isDragging = true;
        startX = e.clientX;
        startY = e.clientY;

        const rect = element.getBoundingClientRect();
        startLeft = rect.left;
        startTop = rect.top;

        element.style.cursor = 'grabbing';
        draggableArea.style.cursor = 'grabbing';

        // 防止文本选择
        e.preventDefault();
      });

      document.addEventListener('mousemove', (e) => {
        if (!isDragging) return;

        const deltaX = e.clientX - startX;
        const deltaY = e.clientY - startY;

        let newLeft = startLeft + deltaX;
        let newTop = startTop + deltaY;

        // 边界检查
        newLeft = Math.max(0, Math.min(newLeft, window.innerWidth - element.offsetWidth));
        newTop = Math.max(0, Math.min(newTop, window.innerHeight - element.offsetHeight));

        element.style.left = newLeft + 'px';
        element.style.top = newTop + 'px';
        element.style.right = 'auto';
        element.style.bottom = 'auto';
      });

      document.addEventListener('mouseup', () => {
        if (isDragging) {
          isDragging = false;
          element.style.cursor = '';
          draggableArea.style.cursor = this.isMinimized ? 'move' : '';
        }
      });
    }

    makeDraggableWithDocking(element) {
      let isDragging = false;
      let startX, startY, startLeft, startTop;

      // 获取拖拽区域
      const dragArea = element.querySelector('#drag-area');
      if (!dragArea) {
        console.warn('未找到拖拽区域');
        return;
      }

      console.log('设置带吸附功能的拖拽');

      // 清理旧的事件监听器（如果存在）
      if (dragArea._dragHandlers) {
        dragArea.removeEventListener('mousedown', dragArea._dragHandlers.mousedown);
        document.removeEventListener('mousemove', dragArea._dragHandlers.mousemove);
        document.removeEventListener('mouseup', dragArea._dragHandlers.mouseup);
      }

      // 设置拖拽区域的样式
      dragArea.style.cursor = 'move';

      const handleMouseDown = (e) => {
        console.log('开始拖拽');
        isDragging = true;
        startX = e.clientX;
        startY = e.clientY;

        const rect = element.getBoundingClientRect();
        startLeft = rect.left;
        startTop = rect.top;

        element.style.cursor = 'grabbing';
        dragArea.style.cursor = 'grabbing';

        // 防止文本选择和事件冒泡
        e.preventDefault();
        e.stopPropagation();
      };

      const handleMouseMove = (e) => {
        if (!isDragging) return;

        const deltaX = e.clientX - startX;
        const deltaY = e.clientY - startY;

        let newLeft = startLeft + deltaX;
        let newTop = startTop + deltaY;

        // 边界检查
        const maxLeft = window.innerWidth - element.offsetWidth;
        const maxTop = window.innerHeight - element.offsetHeight;

        newLeft = Math.max(0, Math.min(newLeft, maxLeft));
        newTop = Math.max(0, Math.min(newTop, maxTop));

        element.style.left = newLeft + 'px';
        element.style.top = newTop + 'px';
        element.style.right = 'auto';
        element.style.bottom = 'auto';

        // 检查是否接近边缘，显示吸附提示
        this.showDockingHint(element, newLeft, newTop);
      };

      const handleMouseUp = () => {
        if (isDragging) {
          console.log('结束拖拽');
          isDragging = false;
          element.style.cursor = '';
          dragArea.style.cursor = 'move';

          // 隐藏吸附提示
          this.hideDockingHint();

          // 检查是否需要吸附
          const rect = element.getBoundingClientRect();
          const dockResult = this.checkDocking(rect.left, rect.top, element.offsetWidth, element.offsetHeight);

          if (dockResult.isDocked) {
            console.log('执行吸附到:', dockResult.side);
            this.executeDocking(element, dockResult);
          } else {
            // 保存当前位置
            this.playerPosition = {
              left: rect.left,
              top: rect.top,
              isDocked: false,
            };
            this.savePlayerState();
          }
        }
      };

      // 添加事件监听器
      dragArea.addEventListener('mousedown', handleMouseDown);
      document.addEventListener('mousemove', handleMouseMove);
      document.addEventListener('mouseup', handleMouseUp);

      // 保存事件引用以便清理
      dragArea._dragHandlers = {
        mousedown: handleMouseDown,
        mousemove: handleMouseMove,
        mouseup: handleMouseUp,
      };

      console.log('带吸附功能的拖拽设置完成');
    }

    // 检查是否需要吸附
    checkDocking(left, top, width, height) {
      const dockThreshold = 50; // 吸附阈值
      const windowWidth = window.innerWidth;
      const windowHeight = window.innerHeight;

      // 检查左侧吸附
      if (left <= dockThreshold) {
        return {
          isDocked: true,
          side: 'left',
          position: {
            left: 0,
            top: Math.max(0, Math.min(top, windowHeight - height)),
          },
        };
      }

      // 检查右侧吸附
      if (left + width >= windowWidth - dockThreshold) {
        return {
          isDocked: true,
          side: 'right',
          position: {
            left: windowWidth - width,
            top: Math.max(0, Math.min(top, windowHeight - height)),
          },
        };
      }

      return { isDocked: false };
    }

    // 显示吸附提示
    showDockingHint(element, left, top) {
      const dockResult = this.checkDocking(left, top, element.offsetWidth, element.offsetHeight);

      if (dockResult.isDocked) {
        // 创建或更新吸附提示
        let hint = document.getElementById('docking-hint');
        if (!hint) {
          hint = document.createElement('div');
          hint.id = 'docking-hint';
          hint.style.cssText = `
            position: fixed;
            background: rgba(74, 144, 226, 0.3);
            border: 2px dashed #4a90e2;
            border-radius: 8px;
            pointer-events: none;
            z-index: 9998;
            transition: all 0.2s ease;
          `;
          document.body.appendChild(hint);
        }

        // 设置提示位置和大小
        if (dockResult.side === 'left') {
          hint.style.left = '0px';
          hint.style.top = dockResult.position.top + 'px';
          hint.style.width = '60px';
          hint.style.height = element.offsetHeight + 'px';
        } else if (dockResult.side === 'right') {
          hint.style.left = window.innerWidth - 60 + 'px';
          hint.style.top = dockResult.position.top + 'px';
          hint.style.width = '60px';
          hint.style.height = element.offsetHeight + 'px';
        }

        hint.style.display = 'block';
      } else {
        this.hideDockingHint();
      }
    }

    // 隐藏吸附提示
    hideDockingHint() {
      const hint = document.getElementById('docking-hint');
      if (hint) {
        hint.style.display = 'none';
      }
    }

    // 执行吸附
    executeDocking(element, dockResult) {
      console.log('执行吸附到:', dockResult.side);

      // 设置吸附位置
      element.style.left = dockResult.position.left + 'px';
      element.style.top = dockResult.position.top + 'px';
      element.style.right = 'auto';
      element.style.bottom = 'auto';

      // 添加吸附状态类
      element.classList.add('docked', `docked-${dockResult.side}`);

      // 保存吸附状态
      this.playerPosition = {
        left: dockResult.position.left,
        top: dockResult.position.top,
        isDocked: true,
        dockedSide: dockResult.side,
      };
      this.savePlayerState();

      // 添加吸附动画
      element.style.transition = 'all 0.3s cubic-bezier(0.4, 0, 0.2, 1)';
      setTimeout(() => {
        element.style.transition = '';
      }, 300);

      // 添加悬停展开功能
      this.setupDockingHoverEvents(element);
    }

    // 设置吸附状态下的悬停展开功能
    setupDockingHoverEvents(element) {
      if (!element.classList.contains('docked')) return;

      let hoverTimer = null;
      let isExpanded = false;
      let isMouseNear = false;
      let checkInterval = null;

      const expandPlayer = () => {
        if (isExpanded) return;
        isExpanded = true;

        const dockedSide = element.classList.contains('docked-left') ? 'left' : 'right';

        if (dockedSide === 'left') {
          element.style.transform = 'translateX(0)';
        } else {
          element.style.transform = 'translateX(0)';
        }

        element.style.transition = 'transform 0.3s cubic-bezier(0.4, 0, 0.2, 1)';
        element.style.zIndex = '9999';
      };

      const collapsePlayer = () => {
        if (!isExpanded) return;
        isExpanded = false;

        const dockedSide = element.classList.contains('docked-left') ? 'left' : 'right';

        if (dockedSide === 'left') {
          element.style.transform = 'translateX(-255px)'; // 只露出25px
        } else {
          element.style.transform = 'translateX(255px)'; // 只露出25px
        }

        element.style.transition = 'transform 0.3s cubic-bezier(0.4, 0, 0.2, 1)';
        element.style.zIndex = '50';
      };

      // 检查鼠标是否在播放器附近
      const checkMousePosition = (event) => {
        const rect = element.getBoundingClientRect();
        const dockedSide = element.classList.contains('docked-left') ? 'left' : 'right';
        const buffer = 50; // 缓冲区域

        let isNear = false;

        if (dockedSide === 'left') {
          // 左侧吸附：检查鼠标是否在左侧区域
          isNear =
            event.clientX <= rect.right + buffer && event.clientY >= rect.top - buffer && event.clientY <= rect.bottom + buffer;
        } else {
          // 右侧吸附：检查鼠标是否在右侧区域
          isNear =
            event.clientX >= rect.left - buffer && event.clientY >= rect.top - buffer && event.clientY <= rect.bottom + buffer;
        }

        if (isNear && !isMouseNear) {
          isMouseNear = true;
          if (hoverTimer) {
            clearTimeout(hoverTimer);
            hoverTimer = null;
          }
          expandPlayer();
        } else if (!isNear && isMouseNear) {
          isMouseNear = false;
          if (hoverTimer) {
            clearTimeout(hoverTimer);
          }
          hoverTimer = setTimeout(() => {
            collapsePlayer();
          }, 800); // 增加延迟时间到800ms
        }
      };

      // 使用全局鼠标移动事件来检测
      const handleMouseMove = (event) => {
        checkMousePosition(event);
      };

      // 添加全局鼠标移动监听
      document.addEventListener('mousemove', handleMouseMove);

      // 清理函数
      element._cleanupHoverEvents = () => {
        document.removeEventListener('mousemove', handleMouseMove);
        if (hoverTimer) {
          clearTimeout(hoverTimer);
        }
        if (checkInterval) {
          clearInterval(checkInterval);
        }
      };

      // 初始状态：收缩
      setTimeout(() => {
        collapsePlayer();
      }, 100);
    }

    // 处理最小化播放器的点击事件
    handleMinimizedPlayerClick(event) {
      console.log('最小化播放器按钮被点击');
      event.preventDefault();
      event.stopPropagation();

      // 简单判断：如果在200ms内没有第二次点击，就执行单击操作
      if (this.clickTimer) {
        clearTimeout(this.clickTimer);
        this.clickTimer = null;
        // 双击：展开播放器
        console.log('双击: 展开播放器');
        this.expandPlayer();
      } else {
        this.clickTimer = setTimeout(() => {
          // 单击：播放/暂停
          console.log('单击: 播放/暂停');
          this.togglePlay();
          this.clickTimer = null;
        }, 200);
      }
    }

    togglePlay() {
      console.log('🎵 togglePlay 被调用，当前状态:', this.isPlaying);

      if (!this.audioElement) {
        console.error('❌ 音频元素未初始化');
        return;
      }

      // 确保有当前曲目
      if (!this.currentTrack) {
        if (this.playlist.length > 0) {
          this.currentTrack = this.playlist[0];
          this.currentTrackIndex = 0;
          this.audioElement.src = this.resolveAudioPath(this.currentTrack.src);
          this.updateTrackInfo();
          console.log('✅ 设置默认曲目:', this.currentTrack.title);
        } else {
          console.error('❌ 没有播放列表');
          alert('没有可播放的音乐，请检查 /music/playlist.json 文件');
          return;
        }
      }

      if (this.isPlaying) {
        // 暂停播放
        console.log('⏸️ 暂停播放');
        this.audioElement.pause();
        // 注意：isPlaying 状态会在 pause 事件监听器中设置
      } else {
        // 开始播放
        console.log('▶️ 开始播放:', this.currentTrack.title);
        console.log('🔗 音频路径:', this.audioElement.src);

        // 确保音频源已设置
        if (!this.audioElement.src || this.audioElement.src !== this.resolveAudioPath(this.currentTrack.src)) {
          this.audioElement.src = this.resolveAudioPath(this.currentTrack.src);
        }

        // 异步播放音频
        const playPromise = this.audioElement.play();
        if (playPromise !== undefined) {
          playPromise
            .then(() => {
              console.log('✅ 播放成功:', this.currentTrack.title);
              // 注意：isPlaying 状态会在 play 事件监听器中设置
            })
            .catch((error) => {
              console.error('❌ 播放失败:', error);
              console.error('📋 错误详情:', {
                track: this.currentTrack,
                src: this.audioElement.src,
                networkState: this.audioElement.networkState,
                readyState: this.audioElement.readyState,
                error: this.audioElement.error,
              });

              // 播放失败时确保状态正确
              this.isPlaying = false;
              this.updateUI();
              this.savePlayerState();
              alert(`播放失败: ${this.currentTrack.title}
请检查音频文件是否存在`);
            });
        } else {
          // 如果没有返回Promise，直接更新状态
          this.isPlaying = true;
          this.updateUI();
          this.savePlayerState();
        }
      }
    }

    previousTrack() {
      if (this.playlist.length === 0) {
        alert('没有播放列表');
        return;
      }

      const wasPlaying = this.isPlaying;

      this.currentTrackIndex = (this.currentTrackIndex - 1 + this.playlist.length) % this.playlist.length;
      this.currentTrack = this.playlist[this.currentTrackIndex];
      this.audioElement.src = this.resolveAudioPath(this.currentTrack.src);

      // 无论之前是否在播放，切换歌曲后都应该播放新歌曲
      const playPromise = this.audioElement.play();
      if (playPromise !== undefined) {
        playPromise
          .then(() => {
            this.isPlaying = true;
            this.updateUI();
            this.savePlayerState();
          })
          .catch(() => {
            this.isPlaying = false;
            this.updateUI();
          });
      } else {
        this.isPlaying = true;
        this.updateUI();
        this.savePlayerState();
      }

      this.updateTrackInfo();
      console.log('上一首:', this.currentTrack.title, '- 自动播放');
    }

    nextTrack() {
      if (this.playlist.length === 0) {
        alert('没有播放列表');
        return;
      }

      const wasPlaying = this.isPlaying;

      this.currentTrackIndex = (this.currentTrackIndex + 1) % this.playlist.length;
      this.currentTrack = this.playlist[this.currentTrackIndex];
      this.audioElement.src = this.resolveAudioPath(this.currentTrack.src);

      // 无论之前是否在播放，切换歌曲后都应该播放新歌曲
      const playPromise = this.audioElement.play();
      if (playPromise !== undefined) {
        playPromise
          .then(() => {
            this.isPlaying = true;
            this.updateUI();
            this.savePlayerState();
          })
          .catch(() => {
            this.isPlaying = false;
            this.updateUI();
          });
      } else {
        this.isPlaying = true;
        this.updateUI();
        this.savePlayerState();
      }

      this.updateTrackInfo();
      console.log('下一首:', this.currentTrack.title, '- 自动播放');
    }

    showPlaylist() {
      if (this.playlist.length === 0) {
        alert('没有播放列表，请检查 /music/playlist.json 文件');
        return;
      }

      // 检查是否已经存在播放列表窗口
      const existingPlaylist = document.getElementById('beautiful-playlist-window');
      if (existingPlaylist) {
        existingPlaylist.remove();
        return;
      }

      // 获取播放器位置来定位播放列表
      const player = document.getElementById('music-player');
      if (!player) return;

      const playerRect = player.getBoundingClientRect();
      const playlistWidth = 384; // w-96 = 384px
      const playlistHeight = 512; // max-h-[32rem] = 512px

      // 计算播放列表位置（播放器左侧，如果空间不够则在播放器前端）
      let playlistLeft, playlistTop;

      if (playerRect.left >= playlistWidth + 20) {
        // 播放器左侧有足够空间
        playlistLeft = playerRect.left - playlistWidth - 20;
        playlistTop = Math.max(20, playerRect.top - (playlistHeight - playerRect.height) / 2);
      } else {
        // 空间不够，在播放器前端显示
        playlistLeft = Math.max(20, (window.innerWidth - playlistWidth) / 2);
        playlistTop = Math.max(20, (window.innerHeight - playlistHeight) / 2);
      }

      // 确保不超出屏幕边界
      playlistLeft = Math.min(playlistLeft, window.innerWidth - playlistWidth - 20);
      playlistTop = Math.min(playlistTop, window.innerHeight - playlistHeight - 20);

      // 创建美观的播放列表窗口（采用与播放器一致的设计风格）
      const playlistWindow = document.createElement('div');
      playlistWindow.id = 'beautiful-playlist-window';
      playlistWindow.className =
        'fixed w-96 max-h-[32rem] bg-gradient-to-br from-amber-50/90 via-white/90 to-amber-100/90 rounded-2xl flex flex-col overflow-hidden backdrop-blur-xl border border-amber-200/50 shadow-2xl z-50';
      playlistWindow.style.left = playlistLeft + 'px';
      playlistWindow.style.top = playlistTop + 'px';

      let playlistHTML = `
        <!-- 标题栏 -->
        <div class="flex items-center justify-between p-4 border-b border-amber-200/30 bg-gradient-to-r from-amber-100/50 to-amber-50/50 rounded-t-2xl">
          <div class="flex items-center space-x-2">
            <div class="w-8 h-8 bg-gradient-to-r from-amber-500 to-amber-600 rounded-lg flex items-center justify-center shadow-sm">
              <svg class="w-4 h-4 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 19V6l12-3v13M9 19c0 1.105-1.343 2-3 2s-3-.895-3-2 1.343-2 3-2 3 .895 3 2zm12-3c0 1.105-1.343 2-3 2s-3-.895-3-2 1.343-2 3-2 3 .895 3 2zM9 10l12-3"></path>
              </svg>
            </div>
            <h3 class="text-lg font-bold bg-gradient-to-r from-amber-700 to-amber-800 bg-clip-text text-transparent">播放列表</h3>
          </div>
          <button id="close-beautiful-playlist" class="text-amber-600 hover:text-amber-800 w-8 h-8 flex items-center justify-center hover:bg-amber-100/50 rounded-lg transition-all duration-200 hover:scale-110">
            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"></path>
            </svg>
          </button>
        </div>
        
        <!-- 播放列表内容 -->
        <div class="flex-1 overflow-y-auto p-4 beautiful-playlist-scroll relative">
          <!-- 背景装饰 -->
          <div class="absolute inset-0 bg-gradient-to-b from-purple-50/30 via-blue-50/30 to-purple-50/30 opacity-50 pointer-events-none"></div>
          <div class="relative z-10">
      `;

      if (this.playlist.length === 0) {
        playlistHTML += `
          <div class="flex flex-col items-center justify-center h-32 text-slate-500 rounded-xl bg-white/50 backdrop-blur-sm border border-white/50 shadow-sm">
            <svg class="w-12 h-12 mb-3 opacity-50 text-slate-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M9 19V6l12-3v13M9 19c0 1.105-1.343 2-3 2s-3-.895-3-2 1.343-2 3-2 3 .895 3 2zm12-3c0 1.105-1.343 2-3 2s-3-.895-3-2 1.343-2 3-2 3 .895 3 2zM9 10l12-3"></path>
            </svg>
            <p class="text-sm font-medium text-slate-500">播放列表为空</p>
            <p class="text-xs mt-1 text-slate-400">添加一些音乐来开始播放</p>
          </div>
        `;
      } else {
        this.playlist.forEach((track, index) => {
          const isCurrentTrack = index === this.currentTrackIndex;
          playlistHTML += `
            <div class="group mb-3 last:mb-0 playlist-track-item relative overflow-hidden rounded-xl transition-all duration-300 ${isCurrentTrack ? 'scale-[1.02]' : ''}" data-index="${index}">
              <!-- 背景光晕效果 -->
              ${
                isCurrentTrack
                  ? `
                <div class="absolute inset-0 bg-gradient-to-r from-purple-500/10 via-blue-500/10 to-purple-500/10 rounded-xl blur-xl animate-pulse"></div>
              `
                  : ''
              }
              
              <div class="flex items-center p-4 rounded-xl cursor-pointer transition-all duration-300 relative z-10 ${
                isCurrentTrack
                  ? 'bg-gradient-to-r from-purple-500/15 via-blue-500/15 to-purple-500/15 backdrop-blur-sm border border-purple-300/50 shadow-lg shadow-purple-500/20'
                  : 'bg-white/60 hover:bg-white/90 backdrop-blur-sm border border-white/50 hover:border-slate-300/50 shadow-sm hover:shadow-md'
              }">
                <!-- 播放状态指示器 -->
                <div class="flex-shrink-0 w-12 h-12 mr-4 flex items-center justify-center relative">
                  ${
                    isCurrentTrack
                      ? `
                    <!-- 当前播放的动画唱片 -->
                    <div class="absolute inset-0 rounded-full bg-gradient-to-br from-purple-500 to-blue-500 animate-spin opacity-80" style="animation-duration: 3s;"></div>
                    <div class="absolute inset-1 rounded-full bg-white/90"></div>
                    <div class="relative w-6 h-6 flex items-center justify-center">
                      <svg class="w-3 h-3 text-purple-600" fill="currentColor" viewBox="0 0 24 24">
                        <path d="M8 5v14l11-7z"/>
                      </svg>
                    </div>
                  `
                      : `
                    <!-- 普通歌曲的播放按钮 -->
                    <div class="w-10 h-10 bg-gradient-to-br from-slate-100 to-slate-200 group-hover:from-slate-200 group-hover:to-slate-300 rounded-full flex items-center justify-center transition-all duration-300 shadow-inner group-hover:shadow-md">
                      <svg class="w-4 h-4 text-slate-500 group-hover:text-slate-700 opacity-60 group-hover:opacity-100 transition-all duration-300" fill="currentColor" viewBox="0 0 24 24">
                        <path d="M8 5v14l11-7z"/>
                      </svg>
                    </div>
                  `
                  }
                </div>
                
                <!-- 歌曲信息 -->
                <div class="flex-1 min-w-0">
                  <div class="font-bold text-slate-800 truncate ${isCurrentTrack ? 'text-purple-800 text-lg' : 'group-hover:text-slate-900'} transition-colors duration-200">
                    ${track.title}
                  </div>
                  <div class="text-sm text-slate-600 truncate mt-1 ${isCurrentTrack ? 'text-purple-600 font-medium' : 'group-hover:text-slate-700'} transition-colors duration-200">
                    ${track.artist}
                  </div>
                  
                  <!-- 进度条 (仅当前播放歌曲显示) -->
                  ${
                    isCurrentTrack
                      ? `
                    <div class="mt-2 w-full h-1 bg-slate-200/50 rounded-full overflow-hidden">
                      <div class="h-full bg-gradient-to-r from-purple-500 to-blue-500 rounded-full animate-pulse" style="width: 45%;"></div>
                    </div>
                  `
                      : ''
                  }
                </div>
                
                <!-- 当前播放指示器 -->
                ${
                  isCurrentTrack
                    ? `
                  <div class="flex-shrink-0 ml-3">
                    <div class="flex items-center space-x-1">
                      <div class="w-2 h-5 bg-gradient-to-t from-purple-500 to-blue-500 rounded-full animate-pulse"></div>
                      <div class="w-2 h-6 bg-gradient-to-t from-blue-500 to-purple-500 rounded-full animate-pulse" style="animation-delay: 0.2s"></div>
                      <div class="w-2 h-4 bg-gradient-to-t from-purple-500 to-blue-500 rounded-full animate-pulse" style="animation-delay: 0.4s"></div>
                    </div>
                  </div>
                `
                    : ''
                }
              </div>
              
              <!-- 悬停时的装饰元素 -->
              <div class="absolute -top-4 -right-4 w-16 h-16 bg-gradient-to-br from-purple-400/20 to-blue-400/20 rounded-full blur-lg transition-all duration-500 group-hover:opacity-100 ${isCurrentTrack ? 'opacity-100' : 'opacity-0'}"></div>
            </div>
          `;
        });
      }

      playlistHTML += `
          </div>
        </div>
      `;

      playlistWindow.innerHTML = playlistHTML;
      document.body.appendChild(playlistWindow);

      // 绑定事件
      this.setupBeautifulPlaylistEvents(playlistWindow);

      // 添加展开动画
      playlistWindow.style.opacity = '0';
      playlistWindow.style.transform = 'scale(0.8)';
      setTimeout(() => {
        playlistWindow.style.transition = 'all 0.3s ease';
        playlistWindow.style.opacity = '1';
        playlistWindow.style.transform = 'scale(1)';
      }, 10);
    }

    setupBeautifulPlaylistEvents(playlistWindow) {
      // 关闭按钮
      const closeBtn = playlistWindow.querySelector('#close-beautiful-playlist');
      if (closeBtn) {
        closeBtn.addEventListener('click', () => {
          playlistWindow.style.transition = 'all 0.3s ease';
          playlistWindow.style.opacity = '0';
          playlistWindow.style.transform = 'scale(0.8)';
          setTimeout(() => {
            playlistWindow.remove();
          }, 300);
        });
      }

      // 歌曲项点击事件
      const playlistItems = playlistWindow.querySelectorAll('.playlist-track-item');
      playlistItems.forEach((item) => {
        item.addEventListener('click', () => {
          const index = parseInt(item.dataset.index);
          this.playTrackByIndex(index);
          // 关闭播放列表
          closeBtn.click();
        });
      });

      // 点击外部关闭
      setTimeout(() => {
        const handleClickOutside = (e) => {
          if (!playlistWindow.contains(e.target)) {
            closeBtn.click();
            document.removeEventListener('click', handleClickOutside);
          }
        };
        document.addEventListener('click', handleClickOutside);
      }, 100);
    }

    playTrackByIndex(index) {
      if (index < 0 || index >= this.playlist.length) return;

      this.currentTrackIndex = index;
      this.currentTrack = this.playlist[index];
      this.audioElement.src = this.resolveAudioPath(this.currentTrack.src);

      // 无论之前是否在播放，切换歌曲后都应该播放新歌曲
      const playPromise = this.audioElement.play();
      if (playPromise !== undefined) {
        playPromise
          .then(() => {
            this.isPlaying = true;
            this.updateUI();
            this.savePlayerState();
          })
          .catch(() => {
            this.isPlaying = false;
            this.updateUI();
          });
      } else {
        this.isPlaying = true;
        this.updateUI();
        this.savePlayerState();
      }

      this.updateTrackInfo();
      console.log('切换到:', this.currentTrack.title, '- 自动播放');
    }

    seekTo(event) {
      if (!this.audioElement || !this.audioElement.duration) return;

      const rect = event.target.getBoundingClientRect();
      const clickX = event.clientX - rect.left;
      const percentage = clickX / rect.width;

      this.audioElement.currentTime = percentage * this.audioElement.duration;
      this.updateProgressDisplay();
    }

    updateTrackInfo() {
      const songTitleLabel = document.getElementById('song-title-label');
      const artistLabel = document.getElementById('artist-label');

      if (this.currentTrack) {
        const title = this.currentTrack.title;
        const artist = this.currentTrack.artist;

        if (songTitleLabel) {
          songTitleLabel.textContent = title;
        }
        if (artistLabel) {
          artistLabel.textContent = artist;
        }
      }
    }


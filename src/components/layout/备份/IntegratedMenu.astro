    // 字体设置函数 - 用于圆盘字体选择器
    window.setFont = function(fontName) {
      console.log('设置字体为:', fontName);
      
      // 字体映射表
      const fontMapping = {
        'Inter': {
          family: 'Inter, -apple-system, BlinkMacSystemFont, "Segoe UI", sans-serif',
          name: 'Inter'
        },
        'Roboto': {
          family: 'Roboto, -apple-system, BlinkMacSystemFont, "Segoe UI", sans-serif',
          name: 'Roboto'
        },
        'Nunito': {
          family: 'Nunito, -apple-system, BlinkMacSystemFont, "Segoe UI", sans-serif',
          name: 'Nunito'
        },
        'Fira Sans': {
          family: '"Fira Sans", -apple-system, BlinkMacSystemFont, "Segoe UI", sans-serif',
          name: 'Fira Sans'
        },
        'Source Sans Pro': {
          family: '"Source Sans Pro", -apple-system, BlinkMacSystemFont, "Segoe UI", sans-serif',
          name: 'Source Sans Pro'
        },
        'Crimson Text': {
          family: '"Crimson Text", "Noto Serif SC", serif',
          name: 'Crimson Text'
        },
        'Merriweather': {
          family: 'Merriweather, "Noto Serif SC", serif',
          name: 'Merriweather'
        },
        'Lora': {
          family: 'Lora, "Noto Serif SC", serif',
          name: 'Lora'
        },
        'Dancing Script': {
          family: '"Dancing Script", "Ma Shan Zheng", cursive',
          name: 'Dancing Script'
        },
        'Pacifico': {
          family: 'Pacifico, "Ma Shan Zheng", cursive',
          name: 'Pacifico'
        },
        'Caveat': {
          family: 'Caveat, "Ma Shan Zheng", cursive',
          name: 'Caveat'
        },
        'Kalam': {
          family: 'Kalam, "Ma Shan Zheng", cursive',
          name: 'Kalam'
        }
      };
      
      const fontData = fontMapping[fontName];
      if (!fontData) {
        console.warn('未找到字体:', fontName);
        return;
      }
      
      // 应用字体到页面
      document.documentElement.style.setProperty('--font-family-base', fontData.family);
      document.body.style.fontFamily = fontData.family;
      
      // 保存字体设置到本地存储
      localStorage.setItem('theme-font', fontName.toLowerCase().replace(/\s+/g, '-'));
      localStorage.setItem('selectedFont', JSON.stringify({
        id: fontName.toLowerCase().replace(/\s+/g, '-'),
        family: fontData.family,
        name: fontData.name
      }));
      
      // 显示切换通知

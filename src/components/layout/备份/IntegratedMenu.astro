    });
    
    // 调试函数 - 测试不同屏幕尺寸的球大小
    window.debugBallSizes = function() {
      const sizes = [480, 768, 1024, 1440, 1920, 2560];
      sizes.forEach(size => {
        const isTouchDevice = 'ontouchstart' in window;
        const touchBonus = isTouchDevice ? 4 : 0;
        let ballSize;
        
        if (size <= 480) ballSize = 20 + touchBonus;
        else if (size <= 768) ballSize = 24 + touchBonus;
        else if (size <= 1024) ballSize = 28 + touchBonus;
        else if (size <= 1440) ballSize = 32;

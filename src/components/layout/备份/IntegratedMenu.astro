        ghostTarget.style.pointerEvents = 'auto';
        ghostTarget.style.transform = 'scale(0.8)'; // 稍微小一点开始
        ghostTarget.style.transition = 'transform 0.2s ease-out';
        
        // 立即放大到正常大小，产生"突然出现"的效果
        setTimeout(() => {
          ghostTarget.style.transform = 'scale(1)';
        }, 50);
        
        // 4. 创建击中闪光效果
        createHitFlash(targetX, targetY);
        
        // 5. 击中幽灵并产生震颤
        ghostTarget.style.animation = 'ghost-shake 0.5s ease-in-out';
        
        // 6. 幽灵飞走
        setTimeout(() => {
          ghostTarget.style.animation = 'ghost-fly-away 1s ease-in-out forwards';
          
          // 7. 显示圆盘菜单
          setTimeout(() => {
            showCircularMenu();
          }, 800);
        }, 500);
        
        // 移除激光和样式（在圆盘菜单出现前消失）
        setTimeout(() => {
          if (laser && laser.parentNode) {
            laser.remove();
          }
          if (style && style.parentNode) {
            style.remove();
          }
        }, 600);
      }, 800);
    }

    // 显示圆盘菜单
    function showCircularMenu() {
      // 获取触发按钮的位置
      const triggerRect = menuTrigger.getBoundingClientRect();
      
      // 计算圆盘菜单位置，确保完全显示在页面上
      // 圆盘应该显示在触发按钮的左下方
      menuTop = triggerRect.bottom + 20;
      menuLeft = triggerRect.left - 160; // 160 = 320(圆盘宽度) - 160(偏移量)
      
      // 获取窗口尺寸
      const windowWidth = window.innerWidth;
      const windowHeight = window.innerHeight;
      
      // 确保圆盘不会超出屏幕边界
      // 左边界检查
      if (menuLeft < 20) {
        menuLeft = 20;
      }
      
      // 右边界检查
      if (menuLeft + 320 > windowWidth - 20) {
        menuLeft = windowWidth - 320 - 20;
      }
      
      // 上边界检查
      if (menuTop < 20) {
        menuTop = 20;
      }
      
      // 下边界检查
      if (menuTop + 320 > windowHeight - 20) {
        menuTop = windowHeight - 320 - 20;
      }
      
      // 设置圆盘菜单位置
      circularMenu.style.top = menuTop + 'px';
      circularMenu.style.left = menuLeft + 'px';
      
      // 重置拖动偏移
      xOffset = 0;
      yOffset = 0;
      setTranslate(0, 0, circularMenu);
      
      circularMenu.style.opacity = '1';
      circularMenu.style.pointerEvents = 'auto';
      circularMenu.style.animation = 'menu-expand 0.5s ease-out forwards';
      isMenuOpen = true;
      isAnimating = false;
      
      // 重新开始图标旋转
      restartIconRotation();
      
      // 添加拖动事件监听器
      dragHandle.addEventListener('mousedown', dragStart);
      document.addEventListener('mouseup', dragEnd);
      document.addEventListener('mousemove', drag);
      
      // 生成颜色球 - 直接使用随机分布版本
      console.log('圆盘菜单已显示，开始生成动态颜色球...');
      
      // 直接调用随机分布版本
      setTimeout(() => {
        showDebugInfo('开始创建随机动态颜色球...');
        
        // 随机选择效果类型
        const effectType = Math.random();
        if (effectType < 0.3) {
          showDebugInfo('使用贪吃蛇效果');
          createSnakeEffect();
          setTimeout(() => createSimpleColorBalls(), 2000); // 2秒后添加其他颜色球
        } else {
          createSimpleColorBalls();
        }
      }, 200);
    }


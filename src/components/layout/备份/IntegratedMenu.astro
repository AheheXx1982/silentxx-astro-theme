    // 获取在二级菜单圆盘内的随机位置
    function getRandomPositionInCircle(maxRadius, minRadius = 0) {
      const angle = Math.random() * 2 * Math.PI;
      const radius = minRadius + Math.random() * (maxRadius - minRadius);
      
      // 二级菜单圆盘大小为320x320，中心点为(160, 160)
      const x = Math.cos(angle) * radius + 160;
      const y = Math.sin(angle) * radius + 160;
      
      // 根据球的大小计算偏移量，保证球不会超出边界
      const screenSize = Math.min(window.innerWidth, window.innerHeight);
      const isTouchDevice = 'ontouchstart' in window;
      const touchBonus = isTouchDevice ? 4 : 0;
      
      let ballSize;
      if (screenSize <= 480) ballSize = 20 + touchBonus;
      else if (screenSize <= 768) ballSize = 24 + touchBonus;
      else if (screenSize <= 1024) ballSize = 28 + touchBonus;
      else if (screenSize <= 1440) ballSize = 32;
      else if (screenSize <= 1920) ballSize = 36;
      else ballSize = 40;
      
      const offset = ballSize / 2;
      return { x: x - offset, y: y - offset };
    }
    

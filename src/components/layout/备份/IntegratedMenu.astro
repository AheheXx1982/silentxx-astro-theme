        } else if (newLeft > maxLeft - snapDistance) {
          musicMenu.classList.add('snap-right');
        } else {
          musicMenu.classList.remove('snap-left', 'snap-right');
        }
      });
      
      document.addEventListener('mouseup', () => {
        if (!isDragging) return;
        
        isDragging = false;
        musicMenu.style.cursor = 'move';
        
        // 获取当前准确位置并保存
        const rect = musicMenu.getBoundingClientRect();
        const position = {
          top: rect.top,
          left: rect.left
        };
        localStorage.setItem('musicPlayerPosition', JSON.stringify(position));
        
        // 检查是否需要贴附
        const snapDistance = 50;
        
        if (rect.left < snapDistance) {
          // 贴附到左边
          dockToSide(musicMenu, 'left');
        } else if (rect.right > window.innerWidth - snapDistance) {
          // 贴附到右边
          dockToSide(musicMenu, 'right');
        }
      });

        document.documentElement.setAttribute('data-theme-color', 'pink');
        console.log('使用默认主题: pink');
      }
    } catch (e) {
      console.log('恢复主题颜色设置失败:', e);
      // 出错时使用默认主题
      document.documentElement.setAttribute('data-theme-color', 'pink');
    }
    
    // 页面加载时恢复主题颜色设置
    try {
      const savedThemeColor = localStorage.getItem('theme-color');
      if (savedThemeColor) {
        console.log('恢复保存的主题颜色:', savedThemeColor);
        // 设置主题颜色属性
        document.documentElement.setAttribute('data-theme-color', savedThemeColor);
      } else {
        // 如果没有保存的主题，使用默认的粉色主题
        document.documentElement.setAttribute('data-theme-color', 'pink');
      }
    } catch (e) {
      console.log('恢复主题颜色设置失败:', e);
      // 出错时使用默认主题
      document.documentElement.setAttribute('data-theme-color', 'pink');
    }
    
    // 字体切换函数 - 用于圆形字体选择器
    window.switchFont = function(fontId, fontFamily, fontName) {

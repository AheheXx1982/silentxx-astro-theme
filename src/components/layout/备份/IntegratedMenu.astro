        // 延迟播放音乐，等待唱针动画完成（1.2秒动画 + 0.3秒缓冲）
        setTimeout(() => {
          if (isPlaying) { // 确保在延迟期间用户没有暂停
            audioElement.play().then(() => {
              showMusicNotification(`🎵 正在播放: ${currentTrack.title}`);
              
              // 开始可视化效果
              drawVisualizer();
              
            }).catch(error => {
              console.error('播放失败:', error);
              showMusicNotification('播放失败');
              // 如果播放失败，重置状态
              isPlaying = false;
              updateTonearmPosition(false);

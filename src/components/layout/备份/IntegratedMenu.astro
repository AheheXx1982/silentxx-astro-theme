        fontOptionsCircle.classList.add('opacity-0', 'pointer-events-none');
        fontOptionsCircle.classList.remove('opacity-100', 'pointer-events-auto');
      }
      
      // 关闭主题菜单
      const themeMenu = document.getElementById('theme-menu');
      if (themeMenu) {
        themeMenu.remove();
        document.removeEventListener('click', closeThemeMenu);
      }
    };
    

---
import { getLanguageFromAstroUrl } from '@lib/i18n';
import FloatingColorBalls from '@components/fun/FloatingColorBalls.astro';

// 获取当前语言
const currentLang = getLanguageFromAstroUrl(Astro.url);

// 获取对应语言的幻念集链接和文本
const thoughtsLink = currentLang === 'en' ? '/en/illusionary-thoughts' : '/illusionary-thoughts';
const thoughtsText = currentLang === 'en' ? 'Illusionary Thoughts' : '幻念集';

// 通用颜色常量 - 与主题系统保持一致
const THEME_COLORS = [
  '#ef4444', '#22c55e', '#3b82f6', '#eab308', '#f97316', '#ed6ea0',
  '#8b5cf6', '#06b6d4', '#10b981', '#6366f1', '#87CEEB', '#f59e0b'
];
---

<div class="integrated-menu group relative">
  <!-- 集成菜单触发按钮 - 使用whirlwind图标 -->
  <button
    class="flex h-12 w-12 items-center justify-center rounded-full border-2 border-white/60 bg-white/30 text-white backdrop-blur-sm transition-all duration-300 hover:scale-110 hover:bg-white/40 focus:ring-2 focus:ring-white/50 focus:outline-none shadow-lg z-20 relative"
    id="menu-trigger"
  >
    <div class="h-8 w-8 flex items-center justify-center">
      <!-- 使用本地whirlwind图标并保持旋转效果，增强视觉效果和可见性 -->
      <img src="/whirlwind.svg" alt="幻念集" class="integrated-menu-icon clockwise-rotation w-full h-full object-contain drop-shadow-[0_0_4px_rgba(255,255,255,0.8)]" loading="eager" />
    </div>
  </button>

  <!-- 激光束容器 -->
  <div id="laser-container" class="fixed inset-0 pointer-events-none z-50"></div>

  <!-- 幽灵图标 - 初始隐藏 -->
  <div id="ghost-target" class="fixed opacity-0 pointer-events-none z-40">
    <img src="/ghost.svg" alt="幽灵目标" class="w-10 h-10" />
  </div>

  <!-- 逆时针旋转的大圆盘二级菜单 -->
  <div id="circular-menu" class="fixed top-0 left-0 w-80 h-80 bg-gradient-to-br from-white/95 via-purple-50/90 to-blue-50/90 backdrop-blur-lg rounded-full shadow-2xl z-50 opacity-0 pointer-events-none draggable-menu circular-menu-rotation border-4 border-white/30">
    <!-- 圆盘中心的幽灵图标 - 最简单实现 -->
    <a href={thoughtsLink} 
       class="absolute top-1/2 left-1/2 transform -translate-x-1/2 -translate-y-1/2 
              w-16 h-16 flex items-center justify-center 
              cursor-pointer hover:scale-110 transition-transform duration-300
              z-50 ghost-icon-container group"
       style="pointer-events: auto !important;">
      <img src="/ghost.svg" 
           alt={thoughtsText} 
           class="w-12 h-12 drop-shadow-[0_0_8px_rgba(255,0,0,0.6)]" />
      <span class="absolute top-full left-1/2 transform -translate-x-1/2 mt-2 
                   text-xs text-gray-600 font-medium opacity-0 group-hover:opacity-100 
                   transition-opacity duration-300 whitespace-nowrap pointer-events-none">
        {thoughtsText}
      </span>
    </a>
    
    <!-- 颜色球容器 - 直接在二级菜单圆盘内部 -->
    <div id="color-balls-container" class="absolute inset-0 rounded-full z-35 pointer-events-none">
      <!-- 颜色球将通过JavaScript动态生成，在圆盘内随机分布 -->
      <!-- 调试信息显示区域 -->
      <div id="debug-info" class="absolute -top-8 left-0 text-xs text-red-500 font-bold z-60"></div>
    </div>
    
    <!-- 音乐播放器 -->
    <button type="button"
       class="absolute top-1/2 left-4 transform -translate-y-1/2 cursor-pointer hover:scale-110 transition-all duration-300 counter-clockwise-rotation menu-item-container z-50" 
       id="music-toggle"
       style="pointer-events: auto !important;">
      <div class="flex flex-col items-center p-3 rounded-full bg-white/60 backdrop-blur-sm shadow-lg border border-pink-200/50 hover:bg-pink-100/70 hover:shadow-xl">
        <svg class="w-6 h-6 text-pink-600 hover:text-pink-800 transition-colors" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 19V6l12-3v13M9 19c0 1.105-1.343 2-3 2s-3-.895-3-2 1.343-2 3-2 3 .895 3 2zm12-3c0 1.105-1.343 2-3 2s-3-.895-3-2 1.343-2 3-2 3 .895 3 2zM9 10l12-3" />
        </svg>
        <span class="text-xs mt-1 text-pink-700 font-medium">音乐</span>
      </div>
    </button>

    <!-- 主题样式选择器 -->
    <button type="button"
       class="absolute top-4 left-1/2 transform -translate-x-1/2 cursor-pointer hover:scale-110 transition-all duration-300 counter-clockwise-rotation menu-item-container z-50" 
       id="theme-toggle"
       style="pointer-events: auto !important;">
      <div class="flex flex-col items-center p-3 rounded-full bg-white/60 backdrop-blur-sm shadow-lg border border-blue-200/50 hover:bg-blue-100/70 hover:shadow-xl">
        <svg class="w-6 h-6 text-blue-600 hover:text-blue-800 transition-colors" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M7 21a4 4 0 01-4-4V5a2 2 0 012-2h4a2 2 0 012 2v12a4 4 0 01-4 4zm0 0h12a2 2 0 002-2v-4a2 2 0 00-2-2h-2.343M11 7.343l1.657-1.657a2 2 0 012.828 0l2.829 2.829a2 2 0 010 2.828l-8.486 8.485M7 17h.01" />
        </svg>
        <span class="text-xs mt-1 text-blue-700 font-medium">主题</span>
      </div>
    </button>
    
    <!-- 语言切换器 -->
    <button type="button"
       class="absolute top-1/2 right-4 transform -translate-y-1/2 cursor-pointer hover:scale-110 transition-all duration-300 counter-clockwise-rotation menu-item-container z-50" 
       id="language-toggle"
       style="pointer-events: auto !important;">
      <div class="flex flex-col items-center p-3 rounded-full bg-white/60 backdrop-blur-sm shadow-lg border border-purple-200/50 hover:bg-purple-100/70 hover:shadow-xl">
        <svg class="w-6 h-6 text-purple-600 hover:text-purple-800 transition-colors" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 5h12M9 3v2m1.048 9.5A18.022 18.022 0 016.412 9m6.088 9h7M11 21l5-10 5 10M12.751 5C11.783 10.77 8.07 15.61 3 18.129" />
        </svg>
        <span class="text-xs mt-1 text-purple-700 font-medium">语言</span>
      </div>
    </button>
    
    <!-- 拖动把手 -->
    <div class="absolute top-1/2 left-1/2 transform -translate-x-1/2 -translate-y-1/2 w-16 h-16 rounded-full cursor-move drag-handle z-40"></div>
    
    <!-- 其他菜单项可以按需添加 -->
  </div>
</div>

<style>
  /* 顺时针旋转动画 */
  .clockwise-rotation {
    animation: rotate-clockwise 8s linear infinite;
  }

  /* 逆时针旋转动画 */
  .counter-clockwise-rotation {
    animation: rotate-counter-clockwise 12s linear infinite;
  }

  /* 圆盘整体逆时针旋转 */
  .circular-menu-rotation {
    animation: rotate-counter-clockwise 20s linear infinite;
  }

  /* 悬停时加速旋转 */
  .integrated-menu:hover .clockwise-rotation {
    animation-duration: 2s;
  }

  /* 简化的旋转控制 */
  .rotation-stopped {
    animation: none !important;
  }

  /* 幽灵图标动画效果 */
  .ghost-icon {
    animation: ghost-float 3s ease-in-out infinite;
  }

  .ghost-glow {
    animation: ghost-glow-pulse 2s ease-in-out infinite alternate;
  }

  .ghost-pulse {
    animation: ghost-pulse-ring 2.5s ease-in-out infinite;
  }

  /* 幽灵图标浮动动画 */
  @keyframes ghost-float {
    0%, 100% {
      transform: translateY(0px);
    }
    50% {
      transform: translateY(-8px);
    }
  }

  /* 幽灵图标发光脉冲 */
  @keyframes ghost-glow-pulse {
    0% {
      opacity: 0.3;
      transform: scale(1);
    }
    100% {
      opacity: 0.6;
      transform: scale(1.1);
    }
  }

  /* 幽灵图标脉冲环动画 */
  @keyframes ghost-pulse-ring {
    0% {
      opacity: 0.8;
      transform: translate(-50%, -50%) scale(0.8);
    }
    50% {
      opacity: 0.4;
      transform: translate(-50%, -50%) scale(1.2);
    }
    100% {
      opacity: 0;
      transform: translate(-50%, -50%) scale(1.5);
    }
  }

  /* 幽灵图标容器悬停效果 */
  .ghost-icon-container:hover .ghost-icon {
    animation-duration: 1.5s;
    filter: drop-shadow(0 0 12px rgba(147, 51, 234, 0.8));
  }

  .ghost-icon-container:hover .ghost-glow {
    animation-duration: 1s;
  }

  .ghost-icon-container:hover .ghost-pulse {
    animation-duration: 1.5s;
  }



  /* 菜单项容器动画 */
  .menu-item-container {
    animation: menu-item-float 4s ease-in-out infinite;
  }

  .menu-item-container:nth-child(2) {
    animation-delay: -1s;
  }

  .menu-item-container:nth-child(3) {
    animation-delay: -2s;
  }

  .menu-item-container:nth-child(4) {
    animation-delay: -3s;
  }

  /* 菜单项浮动动画 */
  @keyframes menu-item-float {
    0%, 100% {
      transform: translateY(0px) rotate(0deg);
    }
    25% {
      transform: translateY(-3px) rotate(1deg);
    }
    50% {
      transform: translateY(-6px) rotate(0deg);
    }
    75% {
      transform: translateY(-3px) rotate(-1deg);
    }
  }

  /* 圆盘菜单展开动画增强 */
  #circular-menu {
    transition: all 0.5s cubic-bezier(0.68, -0.55, 0.265, 1.55);
  }

  #circular-menu.menu-open {
    opacity: 1;
    pointer-events: auto;
    transform: scale(1) rotate(0deg);
  }

  #circular-menu.menu-closed {
    opacity: 0;
    pointer-events: none;
    transform: scale(0.3) rotate(-180deg);
  }

  /* 幽灵图标点击效果 */
  .ghost-click-effect {
    animation: ghost-click-bounce 0.6s cubic-bezier(0.68, -0.55, 0.265, 1.55);
  }

  .ghost-container-click {
    animation: ghost-container-pulse 0.6s ease-out;
  }

  .ghost-click-ripple {
    position: absolute;
    top: 50%;
    left: 50%;
    width: 0;
    height: 0;
    background: radial-gradient(circle, rgba(147, 51, 234, 0.3) 0%, rgba(147, 51, 234, 0) 70%);
    border-radius: 50%;
    transform: translate(-50%, -50%);
    animation: ghost-ripple-expand 1s ease-out forwards;
    pointer-events: none;
    z-index: 5;
  }

  /* 幽灵图标点击弹跳动画 */
  @keyframes ghost-click-bounce {
    0% {
      transform: translateY(0px) scale(1);
    }
    30% {
      transform: translateY(-15px) scale(1.2);
    }
    60% {
      transform: translateY(-8px) scale(1.1);
    }
    100% {
      transform: translateY(0px) scale(1);
    }
  }

  /* 幽灵容器脉冲动画 */
  @keyframes ghost-container-pulse {
    0% {
      transform: scale(1);
      box-shadow: 0 0 0 0 rgba(147, 51, 234, 0.4);
    }
    50% {
      transform: scale(1.05);
      box-shadow: 0 0 0 10px rgba(147, 51, 234, 0.2);
    }
    100% {
      transform: scale(1);
      box-shadow: 0 0 0 20px rgba(147, 51, 234, 0);
    }
  }

  /* 幽灵点击波纹扩展动画 */
  @keyframes ghost-ripple-expand {
    0% {
      width: 0;
      height: 0;
      opacity: 0.8;
    }
    50% {
      width: 100px;
      height: 100px;
      opacity: 0.4;
    }
    100% {
      width: 200px;
      height: 200px;
      opacity: 0;
    }
  }

  /* 颜色球随机动效样式 */
  .color-ball-random {
    will-change: transform, box-shadow;
  }
  
  /* 漂浮动效 */
  @keyframes float-animation {
    0%, 100% { 
      transform: translateY(0px) translateX(0px) rotate(0deg); 
    }
    25% { 
      transform: translateY(-8px) translateX(3px) rotate(2deg); 
    }
    50% { 
      transform: translateY(-4px) translateX(-2px) rotate(-1deg); 
    }
    75% { 
      transform: translateY(-12px) translateX(1px) rotate(3deg); 
    }
  }
  
  /* 弹跳动效 */
  @keyframes bounce-animation {
    0%, 100% { 
      transform: translateY(0px) scale(1); 
    }
    30% { 
      transform: translateY(-15px) scale(1.1); 
    }
    60% { 
      transform: translateY(-8px) scale(1.05); 
    }
    80% { 
      transform: translateY(-3px) scale(1.02); 
    }
  }
  
  /* 脉冲动效 */
  @keyframes pulse-animation {
    0%, 100% { 
      transform: scale(1);
      opacity: 1;
      box-shadow: 0 3px 10px rgba(0,0,0,0.4);
    }
    50% { 
      transform: scale(1.2);
      opacity: 0.8;
      box-shadow: 0 5px 20px rgba(0,0,0,0.6);
    }
  }
  
  /* 震动动效 */
  @keyframes shake-animation {
    0%, 100% { 
      transform: translateX(0px) translateY(0px) rotate(0deg); 
    }
    10% { 
      transform: translateX(-2px) translateY(1px) rotate(1deg); 
    }
    20% { 
      transform: translateX(2px) translateY(-1px) rotate(-1deg); 
    }
    30% { 
      transform: translateX(-1px) translateY(2px) rotate(2deg); 
    }
    40% { 
      transform: translateX(1px) translateY(-2px) rotate(-2deg); 
    }
    50% { 
      transform: translateX(-2px) translateY(0px) rotate(1deg); 
    }
    60% { 
      transform: translateX(2px) translateY(1px) rotate(-1deg); 
    }
    70% { 
      transform: translateX(-1px) translateY(-1px) rotate(1deg); 
    }
    80% { 
      transform: translateX(1px) translateY(1px) rotate(-1deg); 
    }
    90% { 
      transform: translateX(-1px) translateY(0px) rotate(0deg); 
    }
  }
  
  /* 颜色球悬停加强效果 */
  .color-ball-random:hover {
    animation-play-state: paused;
    z-index: 50 !important;
  }
  
  /* 颜色球点击波纹效果 */
  @keyframes click-ripple {
    0% {
      transform: scale(1);
      opacity: 0.8;
    }
    50% {
      transform: scale(2);
      opacity: 0.4;
    }
    100% {
      transform: scale(3);
      opacity: 0;
    }
  }
  
  /* 气球漂浯动效 */
  @keyframes balloon-animation {
    0%, 100% { 
      transform: translateY(0px) rotate(0deg); 
    }
    25% { 
      transform: translateY(-20px) rotate(5deg); 
    }
    50% { 
      transform: translateY(-15px) rotate(-3deg); 
    }
    75% { 
      transform: translateY(-25px) rotate(8deg); 
    }
  }
  
  /* 泡泡上升动效 */
  @keyframes bubble-animation {
    0% { 
      transform: translateY(0px) scale(1);
      opacity: 0.8;
    }
    50% { 
      transform: translateY(-30px) scale(1.2);
      opacity: 1;
    }
    100% { 
      transform: translateY(-10px) scale(0.9);
      opacity: 0.7;
    }
  }
  
  /* 轨道动效 */
  @keyframes orbit-animation {
    0% { 
      transform: rotate(0deg) translateX(20px) rotate(0deg); 
    }
    100% { 
      transform: rotate(360deg) translateX(20px) rotate(-360deg); 
    }
  }
  
  /* 贪吃蛇路径动效 - 适应320x320圆盘 */
  @keyframes snake-path-circle {
    0% { 
      left: 80px; 
      top: 160px; 
    }
    12.5% { 
      left: 130px; 
      top: 70px; 
    }
    25% { 
      left: 220px; 
      top: 100px; 
    }
    37.5% { 
      left: 250px; 
      top: 180px; 
    }
    50% { 
      left: 200px; 
      top: 240px; 
    }
    62.5% { 
      left: 120px; 
      top: 220px; 
    }
    75% { 
      left: 70px; 
      top: 140px; 
    }
    87.5% { 
      left: 110px; 
      top: 80px; 
    }
    100% { 
      left: 80px; 
      top: 160px; 
    }
  }

  /* 颜色球跳动动画 - 更生动的效果 */
  @keyframes ball-jump {
    0% { 
      transform: translateY(0) scale(1) rotate(0deg); 
    }
    15% { 
      transform: translateY(-12px) scale(1.1) rotate(5deg); 
    }
    30% { 
      transform: translateY(-8px) scale(1.05) rotate(-3deg); 
    }
    45% { 
      transform: translateY(-15px) scale(1.15) rotate(8deg); 
    }
    60% { 
      transform: translateY(-5px) scale(0.95) rotate(-2deg); 
    }
    75% { 
      transform: translateY(-10px) scale(1.08) rotate(4deg); 
    }
    90% { 
      transform: translateY(-2px) scale(1.02) rotate(-1deg); 
    }
    100% { 
      transform: translateY(0) scale(1) rotate(0deg); 
    }
  }

  .ball-jump {
    animation: ball-jump 1.2s cubic-bezier(0.68, -0.55, 0.265, 1.55) infinite;
  }

  /* 颜色球漂浮动画 */
  @keyframes ball-float {
    0%, 100% { 
      transform: translateY(0) translateX(0) scale(1); 
    }
    25% { 
      transform: translateY(-3px) translateX(2px) scale(1.02); 
    }
    50% { 
      transform: translateY(-6px) translateX(-1px) scale(1.05); 
    }
    75% { 
      transform: translateY(-2px) translateX(3px) scale(1.03); 
    }
  }

  .ball-float {
    animation: ball-float 3s ease-in-out infinite;
  }

  /* 颜色球发光动画 */
  @keyframes ball-glow {
    0%, 100% { 
      box-shadow: 0 0 8px rgba(0, 0, 0, 0.5); 
    }
    50% { 
      box-shadow: 0 0 25px currentColor, 0 0 35px currentColor; 
    }
  }

  .ball-glow {
    animation: ball-glow 2s ease-in-out infinite;
  }

  /* 激光轨迹背景 - 强制可见 */
  .laser-trail {
    position: fixed !important;
    height: 16px;
    background: linear-gradient(90deg, 
      rgba(255,0,0,0.7) 0%, 
      rgba(255,0,0,0.9) 50%, 
      rgba(255,0,0,0.7) 100%
    );
    box-shadow: 
      0 0 30px rgba(255,0,0,0.9),
      0 0 60px rgba(255,0,0,0.5);
    transform-origin: left center;
    z-index: 9998 !important;
    opacity: 1 !important;
    animation: laser-trail-flash 0.8s ease-in-out;
    border-radius: 8px;
    pointer-events: none;
  }

  /* 激光束样式 - 强制可见 */
  .laser-beam {
    position: fixed !important;
    height: 8px;
    background: linear-gradient(90deg, 
      rgba(255,255,255,1) 0%, 
      rgba(255,255,255,1) 20%, 
      rgba(255,0,0,1) 40%, 
      rgba(255,255,255,1) 60%, 
      rgba(255,0,0,1) 80%, 
      rgba(255,255,255,1) 100%
    );
    box-shadow: 
      0 0 12px rgba(255,255,255,1),
      0 0 24px rgba(255,0,0,1),
      0 0 36px rgba(255,255,255,0.8),
      0 0 48px rgba(255,0,0,0.7);
    transform-origin: left center;
    z-index: 9999 !important;
    opacity: 1 !important;
    animation: laser-flash 0.8s ease-in-out;
    border-radius: 4px;
    pointer-events: none;
  }

  /* 激光轨迹闪动动画 - 强制可见 */
  @keyframes laser-trail-flash {
    0% {
      opacity: 0.8 !important;
      transform: scaleY(1) scaleX(0);
    }
    10% {
      opacity: 1 !important;
      transform: scaleY(1.2) scaleX(0.3);
    }
    20% {
      opacity: 1 !important;
      transform: scaleY(1.5) scaleX(0.6);
    }
    30% {
      opacity: 1 !important;
      transform: scaleY(1.3) scaleX(1);
    }
    50% {
      opacity: 0.9 !important;
      transform: scaleY(1.1) scaleX(1);
    }
    70% {
      opacity: 0.8 !important;
      transform: scaleY(1) scaleX(1);
    }
    80% {
      opacity: 0.7 !important;
      transform: scaleY(0.9) scaleX(0.9);
    }
    100% {
      opacity: 0.5 !important;
      transform: scaleY(0.8) scaleX(0.6);
    }
  }

  /* 激光闪动动画 - 强制高可见性 */
  @keyframes laser-flash {
    0% {
      opacity: 1 !important;
      transform: scaleY(1) scaleX(0);
      filter: brightness(2);
    }
    5% {
      opacity: 1 !important;
      transform: scaleY(1.5) scaleX(0.2);
      filter: brightness(3);
    }
    10% {
      opacity: 1 !important;
      transform: scaleY(2) scaleX(0.4);
      filter: brightness(4);
    }
    15% {
      opacity: 1 !important;
      transform: scaleY(1.8) scaleX(0.6);
      filter: brightness(3.5);
    }
    20% {
      opacity: 1 !important;
      transform: scaleY(1.5) scaleX(0.8);
      filter: brightness(3);
    }
    25% {
      opacity: 1 !important;
      transform: scaleY(1.2) scaleX(1);
      filter: brightness(2.5);
    }
    30% {
      opacity: 1 !important;
      transform: scaleY(1.8) scaleX(1);
      filter: brightness(3.5);
    }
    40% {
      opacity: 1 !important;
      transform: scaleY(1.5) scaleX(1);
      filter: brightness(3);
    }
    50% {
      opacity: 1 !important;
      transform: scaleY(1.2) scaleX(1);
      filter: brightness(2.5);
    }
    60% {
      opacity: 1 !important;
      transform: scaleY(1.8) scaleX(1);
      filter: brightness(3.5);
    }
    70% {

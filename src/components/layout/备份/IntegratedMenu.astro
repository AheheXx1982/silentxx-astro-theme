    // 拖拽功能
    function makeDraggable(element) {
      let isDragging = false;
      let startX, startY, startLeft, startTop;
      
      element.addEventListener('mousedown', (e) => {
        // 如果点击的是控制按钮，不启动拖拽
        if (e.target.closest('#window-controls')) return;
        // 如果点击的是播放控制按钮，不启动拖拽
        if (e.target.closest('button')) return;
        
        isDragging = true;
        startX = e.clientX;
        startY = e.clientY;
        
        // 获取当前位置
        const rect = element.getBoundingClientRect();
        startLeft = rect.left;
        startTop = rect.top;
        
        element.style.cursor = 'grabbing';
        
        // 防止文本选择
        e.preventDefault();
      });
      
      document.addEventListener('mousemove', (e) => {
        if (!isDragging) return;
        
        const deltaX = e.clientX - startX;
        const deltaY = e.clientY - startY;
        
        let newLeft = startLeft + deltaX;
        let newTop = startTop + deltaY;
        
        // 边界检查
        const elementWidth = 240; // 播放器固定宽度
        const elementHeight = 240; // 播放器固定高度
        const maxLeft = window.innerWidth - elementWidth;
        const maxTop = window.innerHeight - elementHeight;
        
        newLeft = Math.max(0, Math.min(newLeft, maxLeft));
        newTop = Math.max(0, Math.min(newTop, maxTop));
        
        element.style.left = newLeft + 'px';
        element.style.top = newTop + 'px';
        
        // 检查是否接近边缘（贴附检测）
        const snapDistance = 20;
        if (newLeft < snapDistance) {
          element.classList.add('snap-left');
        } else if (newLeft > maxLeft - snapDistance) {
          element.classList.add('snap-right');
        } else {
          element.classList.remove('snap-left', 'snap-right');
        }
      });
      
      document.addEventListener('mouseup', () => {
        if (!isDragging) return;
        
        isDragging = false;
        element.style.cursor = 'move';
        
        // 获取当前准确位置并保存
        const rect = element.getBoundingClientRect();
        const position = {
          top: rect.top,
          left: rect.left
        };
        localStorage.setItem('musicPlayerPosition', JSON.stringify(position));
        
        // 检查是否需要贴附
        const snapDistance = 50;
        
        if (rect.left < snapDistance) {
          // 贴附到左边
          dockToSide(element, 'left');
        } else if (rect.right > window.innerWidth - snapDistance) {
          // 贴附到右边
          dockToSide(element, 'right');
        }
      });
    }
    
    // 贴附到侧边
    function dockToSide(element, side) {
      element.classList.add(`docked-${side}`);
      
      if (side === 'left') {
        element.style.left = '-120px'; // 圆形一半隐藏在边缘
        element.style.right = 'auto';
      } else {
        element.style.right = '-120px'; // 圆形一半隐藏在边缘
        element.style.left = 'auto';
      }
      
      element.style.top = '50%';
      element.style.transform = 'translateY(-50%)';
      
      localStorage.setItem('musicPlayerDocked', 'true');
      localStorage.setItem('musicPlayerDockSide', side);
    }
    
    // 贴附状态切换功能（左侧播放器已删除）


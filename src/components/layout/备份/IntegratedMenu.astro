    // 拖拽功能
    function makeDraggableMinimizedPlayer(element) {
      // 避免重复绑定
      if (element.dataset.draggable === 'true') {
        return;
      }
      element.dataset.draggable = 'true';
      
      let isDragging = false;
      let hasMoved = false; // 添加移动标记
      let startX, startY, startLeft, startTop;
      const DRAG_THRESHOLD = 5; // 拖拽阈值，像素
      
      element.addEventListener('mousedown', function(e) {
        if (e.target.tagName === 'BUTTON' || e.target.closest('button')) {
          return;
        }
        
        isDragging = true;
        hasMoved = false; // 重置移动标记
        element.dataset.isDragging = 'true';
        
        startX = e.clientX;
        startY = e.clientY;
        startLeft = element.offsetLeft;
        startTop = element.offsetTop;
        
        // 暂时不添加拖拽视觉反馈，等确认是拖拽操作时再添加
        
        // 禁用过渡效果和hover效果
        element.style.transition = 'none';
        element.style.cursor = 'grabbing';
        element.style.pointerEvents = 'none'; // 禁用hover效果
        
        // 临时移除hover类
        const originalClassName = element.className;
        element.className = originalClassName.replace('hover:translate-x-1/4', '');
        element.dataset.originalClassName = originalClassName;
        
        document.addEventListener('mousemove', onMouseMove);
        document.addEventListener('mouseup', onMouseUp);
        
        e.preventDefault();
      });
      
      function onMouseMove(e) {
        if (!isDragging) return;
        
        const deltaX = e.clientX - startX;
        const deltaY = e.clientY - startY;
        
        // 检查是否超过拖拽阈值
        const distance = Math.sqrt(deltaX * deltaX + deltaY * deltaY);
        if (!hasMoved && distance > DRAG_THRESHOLD) {
          hasMoved = true;
          // 只有真正开始拖拽时才添加拖拽样式
          element.classList.add('dragging');
        }
        
        // 只有确认是拖拽操作时才移动元素
        if (!hasMoved) return;
        
        let newLeft = startLeft + deltaX;
        let newTop = startTop + deltaY;
        
        // 边界检查
        const rect = element.getBoundingClientRect();
        const maxLeft = window.innerWidth - rect.width;
        const maxTop = window.innerHeight - rect.height;
        
        newLeft = Math.max(0, Math.min(newLeft, maxLeft));
        newTop = Math.max(0, Math.min(newTop, maxTop));
        
        element.style.left = newLeft + 'px';
        element.style.top = newTop + 'px';
        element.style.transform = 'none';
        element.style.right = 'auto';
      }
      
      function onMouseUp(e) {
        if (!isDragging) return;
        
        isDragging = false;
        element.dataset.isDragging = 'false';
        
        // 如果没有移动，说明是点击操作，不执行拖拽逻辑
        if (!hasMoved) {
          // 恢复过渡效果和指针事件
          element.style.transition = 'all 0.3s ease';
          element.style.cursor = 'move';
          element.style.pointerEvents = 'auto';
          
          // 清理事件监听器
          document.removeEventListener('mousemove', onMouseMove);
          document.removeEventListener('mouseup', onMouseUp);
          return; // 直接返回，不执行后续的拖拽结束逻辑
        }
        
        // 移除拖拽视觉反馈
        element.classList.remove('dragging');
        
        // 恢复过渡效果和指针事件
        element.style.transition = 'all 0.3s ease';
        element.style.cursor = 'move';
        element.style.pointerEvents = 'auto'; // 恢复指针事件
        
        // 检查是否靠近右侧边缘（侧边栏模式）
        const rect = element.getBoundingClientRect();
        const isNearRightEdge = rect.right > window.innerWidth - 200;
        
        if (isNearRightEdge) {
          // 回到侧边栏模式
          element.dataset.isDocked = 'true';
          element.className = 'fixed right-0 top-1/2 transform -translate-y-1/2 translate-x-4/5 bg-gradient-to-r from-purple-600 to-blue-600 backdrop-blur-xl border border-white/20 rounded-l-2xl shadow-2xl z-50 transition-all duration-300 hover:translate-x-1/4 cursor-move select-none';
          element.style.left = 'auto';
          element.style.top = '50%';
          element.style.transform = 'translateY(-50%) translateX(80%)';
        } else {
          // 自由拖拽模式
          element.dataset.isDocked = 'false';
          element.className = 'fixed bg-gradient-to-r from-purple-600 to-blue-600 backdrop-blur-xl border border-white/20 rounded-2xl shadow-2xl z-50 transition-all duration-300 cursor-move select-none';
        }
        
        // 延迟更新内容，确保样式设置完成
        setTimeout(() => {
          updateMinimizedPlayerContent(element);
        }, 50);
        
        document.removeEventListener('mousemove', onMouseMove);
        document.removeEventListener('mouseup', onMouseUp);
      }
    }
    

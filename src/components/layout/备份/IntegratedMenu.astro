      if (fontSelector) {
        fontSelector.remove();
        document.removeEventListener('click', handleFontSelectorOutsideClick);
      }
    }
    
    // 处理点击外部关闭字体选择器
    function handleFontSelectorOutsideClick(e) {
      const fontSelector = document.getElementById('font-selector');
      const fontSelectorBtn = document.getElementById('font-selector-btn');
      if (fontSelector && !fontSelector.contains(e.target) && !fontSelectorBtn?.contains(e.target)) {
        closeFontSelector();
      }
    }
    
    // 字体切换函数
    function switchFont(fontId) {
      const currentFont = localStorage.getItem('theme-font') || 'default';
      
      if (fontId === currentFont) {
        return; // 如果是当前字体，不做任何操作
      }
      
      // 保存字体设置
      localStorage.setItem('theme-font', fontId);
      
      // 字体映射
      const fontMapping = {
        'default': 'var(--font-family-base)',
        'modern': 'var(--font-sans-modern)',
        'serif-elegant': 'var(--font-serif-elegant)',
        'serif-readable': 'var(--font-serif-readable)',
        'handwriting-elegant': 'var(--font-handwriting-elegant)',
        'handwriting-casual': 'var(--font-handwriting-casual)',
        'handwriting-fun': 'var(--font-handwriting-fun)'
      };
      
      const fontNames = {
        'default': '默认字体',
        'modern': '现代简洁',
        'serif-elegant': '优雅衣线',
        'serif-readable': '易读舅服',
        'handwriting-elegant': '优雅手写',
        'handwriting-casual': '随意手写',
        'handwriting-fun': '趣味手写'
      };
      
      // 应用字体
      const fontFamily = fontMapping[fontId] || fontMapping['default'];
      document.documentElement.style.setProperty('--font-family-base', fontFamily);
      
      // 更新body字体
      document.body.style.fontFamily = fontFamily;
      
      // 显示字体切换通知
      showFontSwitchNotification(fontNames[fontId] || '默认字体');
    }
    
    // 显示字体切换通知
    function showFontSwitchNotification(fontName) {
      const notification = document.createElement('div');
      notification.className = 'fixed top-4 right-4 z-[9999]';
      notification.style.cssText = `
        background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);

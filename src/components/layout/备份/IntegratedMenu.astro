<script is:inline>
  document.addEventListener('DOMContentLoaded', function () {
    const menuTrigger = document.getElementById('menu-trigger');
    const menuIcon = document.querySelector('.integrated-menu-icon');
    const laserContainer = document.getElementById('laser-container');
    const ghostTarget = document.getElementById('ghost-target');
    const circularMenu = document.getElementById('circular-menu');
    const dragHandle = document.querySelector('.drag-handle');
    const colorBallsContainer = document.getElementById('color-balls-container');
    
    // 获取二级菜单项
    const languageToggle = document.getElementById('language-toggle');
    const themeToggle = document.getElementById('theme-toggle');
    const musicToggle = document.getElementById('music-toggle');

    if (menuIcon) {
      menuIcon.style.opacity = '1';
      menuIcon.style.display = 'block';
      menuIcon.style.visibility = 'visible';
      menuIcon.style.animationPlayState = 'running';
    }

    let timeout;
    
    // 检测是否为移动设备
    const isMobile = window.innerWidth <= 768 || 'ontouchstart' in window;
    
    let isMenuOpen = false;
    let isAnimating = false;
    let isDragging = false;
    let currentX;
    let currentY;
    let initialX;
    let initialY;
    let xOffset = 0;
    let yOffset = 0;
    let menuTop = 0;
    let menuLeft = 0;
    let colorBalls = [];
    let jumpIntervals = [];
    
    // 音乐播放器状态
    let isPlaying = false;
    let currentTrack = null;
    let playlist = [];
    let currentTrackIndex = 0;
    let audioElement = null;
    let audioContext = null;

    
    // 初始化音乐播放器
    async function initMusicPlayer() {
      try {
        // 如果音频上下文已存在且状态正常，不重复初始化
        if (audioContext && audioContext.state !== 'closed' && audioElement) {
          console.log('Music player already initialized, skipping...');
          return;
        }
        
        // 加载播放列表
        const response = await fetch('/music/playlist.json');
        const data = await response.json();
        playlist = data.playlist || [];
        
        // 初始化Web Audio API
        if (!audioContext || audioContext.state === 'closed') {
          audioContext = new (window.AudioContext || window.webkitAudioContext)();
        }
        
        // 创建音频元素（用于非demo音频）
        if (!audioElement) {
          audioElement = new Audio();
          audioElement.volume = 0.7;
          
          // 设置音频事件监听器
          audioElement.addEventListener('ended', () => {
            nextTrack();
          });
          
          audioElement.addEventListener('error', (e) => {
            console.error('音频播放错误:', e);
            showMusicNotification('播放器已关闭');
            isPlaying = false;
            updateMusicToggleIcon();
          });
          
          // 添加时间更新监听器
          audioElement.addEventListener('timeupdate', () => {
            updateSongInfo();
          });
          
          // 添加加载完成监听器
          audioElement.addEventListener('loadedmetadata', () => {
            updateSongInfo();
          });
        }
        
        // 首先尝试从详细状态恢复
        const savedDetailedState = localStorage.getItem('musicPlayerDetailedState');
        if (savedDetailedState) {
          try {
            const state = JSON.parse(savedDetailedState);
            // 检查状态是否过期（超过5分钟则清除）
            const stateAge = Date.now() - (state.timestamp || 0);
            if (stateAge <= 5 * 60 * 1000) {
              console.log('Restoring from detailed state...');
              if (state.playlist && state.playlist.length > 0) {
                playlist = state.playlist;
                currentTrackIndex = state.currentTrackIndex || 0;
                currentTrack = state.currentTrack || playlist[currentTrackIndex];
                isPlaying = state.isPlaying || false;
                
                if (currentTrack) {
                  audioElement.src = currentTrack.src;
                  audioElement.currentTime = state.currentTime || 0;
                  audioElement.volume = state.volume || 0.7;
                }
              }
            } else {
              console.log('Detailed state expired, clearing...');
              localStorage.removeItem('musicPlayerDetailedState');
            }
          } catch (e) {
            console.log('Failed to parse detailed state:', e);
            localStorage.removeItem('musicPlayerDetailedState');
          }
        }
        
        // 如果没有详细状态，尝试从普通状态恢复
        if (!currentTrack) {
          const savedState = localStorage.getItem('musicPlayerState');
          if (savedState) {
            try {
              const state = JSON.parse(savedState);
              isPlaying = state.isPlaying || false;
              currentTrackIndex = state.currentTrackIndex || 0;
              currentTrack = playlist[currentTrackIndex] || playlist[0];
            } catch (e) {
              console.log('Failed to parse basic state:', e);
            }
          } else {
            currentTrack = playlist[0];
          }
        }
        
        // 设置当前音轨
        if (currentTrack && audioElement) {
          audioElement.src = currentTrack.src;
        }
        
        // 检查是否需要恢复播放器UI
        const shouldRestoreUI = localStorage.getItem('musicPlayerState') || localStorage.getItem('musicPlayerMinimized') || savedDetailedState;
        
        // 初始化可视化效果和界面更新
        setTimeout(() => {
          // 如果之前有播放器状态，重新创建UI
          if (shouldRestoreUI) {
            const isMinimized = localStorage.getItem('musicPlayerMinimized') === 'true';
            if (isMinimized) {
              // 直接创建最小化播放器（Qoder的右侧播放器）
              // 这里应该调用创建右侧播放器的函数
              console.log('Should restore minimized player');
            } else {
              // 不再创建左侧播放器
              console.log('Should restore full player - but left player removed');
            }
          }
          
          initVisualizer();
          updateSongInfo();
          updatePlayButton();
          enhanceHoverEffects();
          
          // 如果有保存的播放状态，恢复播放
          if (isPlaying && audioElement && currentTrack) {
            audioElement.play().then(() => {
              drawVisualizer();
              updateTonearmPosition(true);
              updateVinylRotation(true);
            }).catch(() => {
              isPlaying = false;
              updatePlayButton();
              updateTonearmPosition(false);
              updateVinylRotation(false);
            });
          }
        }, 100);
        
        console.log('Music player initialized successfully');
        
      } catch (error) {
        console.error('初始化音乐播放器失败:', error);
        // 如果初始化失败，清理状态并重试
        localStorage.removeItem('musicPlayerDetailedState');
        localStorage.removeItem('musicPlayerState');
        localStorage.removeItem('musicPlayerMinimized');
      }
    }


    
    // 播放/暂停音乐
    function toggleMusic() {
      if (!currentTrack) {
        showMusicNotification('音乐播放器未就绪');
        return;
      }
      
      if (isPlaying) {
        // 停止播放
        audioElement.pause();
        isPlaying = false;
        showMusicNotification('⏸️ 音乐已暂停');
        
        // 停止可视化动画
        if (animationId) {
          cancelAnimationFrame(animationId);
          animationId = null;
        }
        
        // 立即更新动画状态（暂停）
        updateTonearmPosition(false);
        updateVinylRotation(false);
        updatePlayButton(false);
        updateMinimizedPlayerIcons();
        
      } else {
        // 开始播放 - 先启动唱针动画，然后延迟播放音乐
        isPlaying = true; // 先设置状态，让界面显示播放状态
        
        // 立即更新界面状态（播放）
        updateTonearmPosition(true);
        updateVinylRotation(true);
